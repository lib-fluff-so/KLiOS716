 #include <sys/sweet_mali.h>
 
 #define SM_LOG(fmt, ...)  IOLog("SWEETMALI UC: " fmt, ##__VA_ARGS__)
+
+/*
+ * The lock the client door serialises on.
+ *
+ * The core's client entry points -- CREATE_BO/CLOSE_BO/SYNC_BO/WAIT_BO/
+ * SUBMIT/MMAP_BO and the fence calls -- share sm.bo[], sm.sync[], the GPU VA
+ * allocator and the page-table pool, and a normal boot runs two clients at
+ * once: the userspace client launchd spawns, and the in-kernel client stage
+ * D2/D3 opens on the bring-up thread.  They reach the core through
+ * externalMethod(), clientMemoryForType() and clientClose(), so one lock over
+ * those three is enough.  It is an IOLock (a sleeping lck_mtx), and none of
+ * the handlers re-enters the door, so a non-recursive lock is enough.
+ *
+ * The bring-up *thread* is not a client of this door and does not take the
+ * lock: it is kept out of the clients' way by VERSION.ready, which is
+ * published only after the suite that owns the same state has finished (see
+ * sweet_mali_thread() in bsd/dev/sweet_mali.c).
+ *
+ * The helpers tolerate a NULL lock so that a call racing SweetMali::stop()
+ * cannot fault on the freed pointer.
+ */
+static IOLock *sm_client_lock;
+
+static void
+sm_client_lock_take(void)
+{
+	IOLock *lock = sm_client_lock;
+
+	if (lock != NULL) {
+		IOLockLock(lock);
+	}
+}
+
+static void
+sm_client_lock_drop(void)
+{
+	IOLock *lock = sm_client_lock;
+
+	if (lock != NULL) {
+		IOLockUnlock(lock);
+	}
+}
 
