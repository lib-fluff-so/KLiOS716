+	memset(&c, 0, sizeof(c));
+	c.size = SM_BO_PAGE_SIZE;
+	kr = sm_uc_call(uc, SM_SEL_CREATE_BO, &c, sizeof(c), &c, sizeof(c));
+	ntest++;
+	if (kr == kIOReturnSuccess) {
+		nok++;
+		have1 = true;
+		h1 = c.handle;
+	} else {
+		nbad++;
+	}
+	SM_LOG("%s CREATE_BO 1 size=%u handle=%u offset=%llx kr=%x\n",
+	    kr == kIOReturnSuccess ? "ok " : "BAD", SM_BO_PAGE_SIZE, h1,
+	    (unsigned long long)c.offset, kr);
+
+	/* 3: distinct handles */
+	ntest++;
+	ok = have0 && have1 && h0 != h1;
+	if (ok) nok++; else nbad++;
+	SM_LOG("%s handles distinct h0=%u h1=%u\n", ok ? "ok " : "BAD", h0, h1);
+
+	if (!have0 || !have1) {
+		goto out;
+	}
+
+	/* 4/5: the GPU VAs, which are what a descriptor names */
+	memset(&g, 0, sizeof(g));
+	g.handle = h0;
+	kr = sm_uc_call(uc, SM_SEL_GET_BO_OFFSET, &g, sizeof(g), &g, sizeof(g));
+	ntest++;
+	ok = (kr == kIOReturnSuccess && g.offset != 0 &&
+	    (g.offset & (SM_BO_PAGE_SIZE - 1u)) == 0);
+	if (ok) { nok++; va0 = g.offset; } else nbad++;
+	SM_LOG("%s GET_BO_OFFSET 0 va=%llx kr=%x\n", ok ? "ok " : "BAD",
+	    (unsigned long long)g.offset, kr);
+
+	memset(&g, 0, sizeof(g));
+	g.handle = h1;
+	kr = sm_uc_call(uc, SM_SEL_GET_BO_OFFSET, &g, sizeof(g), &g, sizeof(g));
+	ntest++;
+	ok = (kr == kIOReturnSuccess && g.offset != 0 &&
+	    (g.offset & (SM_BO_PAGE_SIZE - 1u)) == 0);
+	if (ok) { nok++; va1 = g.offset; } else nbad++;
+	SM_LOG("%s GET_BO_OFFSET 1 va=%llx kr=%x\n", ok ? "ok " : "BAD",
+	    (unsigned long long)g.offset, kr);
+
+	/* 6: different BOs must land at different addresses */
+	ntest++;
+	ok = (va0 != 0 && va1 != 0 && va0 != va1);
+	if (ok) nok++; else nbad++;
+	SM_LOG("%s BOs at different VAs va0=%llx va1=%llx\n", ok ? "ok " : "BAD",
+	    (unsigned long long)va0, (unsigned long long)va1);
+
+	/* 7: a handle that was never created is refused */
+	memset(&g, 0, sizeof(g));
+	g.handle = 0xffffffffu;
+	kr = sm_uc_call(uc, SM_SEL_GET_BO_OFFSET, &g, sizeof(g), &g, sizeof(g));
+	ntest++;
+	ok = (kr == kIOReturnBadArgument);
+	if (ok) nok++; else nbad++;
+	SM_LOG("%s GET_BO_OFFSET bad handle: kr=%x\n", ok ? "ok " : "BAD", kr);
+
+	if (va0 == 0 || va1 == 0) {
+		goto out;
+	}
+
+	/* 8: the test's own view of both BOs */
+	desc = (volatile uint32_t *)sm_bo_kva(h0);
+	target = (volatile uint64_t *)sm_bo_kva(h1);
+	ntest++;
+	ok = (desc != NULL && target != NULL);
+	if (ok) nok++; else nbad++;
+	SM_LOG("%s bo kva desc=%p target=%p\n", ok ? "ok " : "BAD",
+	    (void *)desc, (void *)target);
+	if (!ok) {
+		goto out;
+	}
+
+	/*
+	 * 9: build the write-value job in BO0 and poison the target in BO1.
+	 * The encoder is here, in the client, on purpose: the kernel's submit
+	 * path only reads `jc` and the handle list, so a value that appears in
+	 * BO1 cannot have come from a descriptor the kernel wrote.
+	 */
+	for (i = 0; i < SM_BO_PAGE_SIZE / 4u; i++) {
+		desc[i] = 0;
+	}
+	desc[4] = ((SM_D2_JOB_WRITE_VALUE & 0x7fu) << 1) | (1u << 16);
+	desc[8] = (uint32_t)va1;
+	desc[9] = (uint32_t)(va1 >> 32);
+	desc[10] = SM_D2_IMM64 & 0x7u;
+	desc[12] = (uint32_t)SM_D2_VALUE;
+	desc[13] = (uint32_t)(SM_D2_VALUE >> 32);
+	*target = SM_D2_SENTINEL;
+
+	memset(&sub, 0, sizeof(sub));
+	sub.jc = va0;
+	sub.bo_count = 2;
+	sub.bo_handles[0] = h0;
+	sub.bo_handles[1] = h1;
+	kr = sm_uc_call(uc, SM_SEL_SUBMIT, &sub, sizeof(sub), &sub, sizeof(sub));
+	ntest++;
+	ok = (kr == kIOReturnSuccess && (sub.rawstat & 1u) != 0 &&
+	    (sub.rawstat & (1u << 16)) == 0 && *target == SM_D2_VALUE);
+	if (ok) nok++; else nbad++;
+	SM_LOG("%s SUBMIT jc=%llx rawstat=%x target=%llx want=%llx kr=%x\n",
+	    ok ? "ok " : "BAD", (unsigned long long)va0, sub.rawstat,
+	    (unsigned long long)*target, (unsigned long long)SM_D2_VALUE, kr);
+
+	/* 10: jc must be inside a *listed* BO */
+	memset(&sub, 0, sizeof(sub));
+	sub.jc = va0;
+	sub.bo_count = 1;
+	sub.bo_handles[0] = h1;
+	kr = sm_uc_call(uc, SM_SEL_SUBMIT, &sub, sizeof(sub), &sub, sizeof(sub));
+	ntest++;
+	ok = (kr == kIOReturnBadArgument);
+	if (ok) nok++; else nbad++;
+	SM_LOG("%s SUBMIT jc not in listed BO: kr=%x\n", ok ? "ok " : "BAD", kr);
+
+	/* 11: jc outside every BO is refused before the doorbell */
+	memset(&sub, 0, sizeof(sub));
+	sub.jc = va0 + 0x20000000ull;
+	sub.bo_count = 1;
+	sub.bo_handles[0] = h0;
+	kr = sm_uc_call(uc, SM_SEL_SUBMIT, &sub, sizeof(sub), &sub, sizeof(sub));
+	ntest++;
+	ok = (kr == kIOReturnBadArgument);
+	if (ok) nok++; else nbad++;
+	SM_LOG("%s SUBMIT jc outside BO: kr=%x\n", ok ? "ok " : "BAD", kr);
+
+	/* 12/13: close the descriptor BO; its VA must stop being submit-able */
+	memset(&cl, 0, sizeof(cl));
+	cl.handle = h0;
+	kr = sm_uc_call(uc, SM_SEL_CLOSE_BO, &cl, sizeof(cl), NULL, 0);
+	ntest++;
+	ok = (kr == kIOReturnSuccess);
+	if (ok) { nok++; have0 = false; } else nbad++;
+	SM_LOG("%s CLOSE_BO 0: kr=%x\n", ok ? "ok " : "BAD", kr);
+
+	memset(&g, 0, sizeof(g));
+	g.handle = h0;
+	kr = sm_uc_call(uc, SM_SEL_GET_BO_OFFSET, &g, sizeof(g), &g, sizeof(g));
+	ntest++;
+	ok = (kr == kIOReturnBadArgument);
+	if (ok) nok++; else nbad++;
+	SM_LOG("%s GET_BO_OFFSET after close: kr=%x\n", ok ? "ok " : "BAD", kr);
+
+	memset(&sub, 0, sizeof(sub));
+	sub.jc = va0;
+	sub.bo_count = 1;
+	sub.bo_handles[0] = h0;
+	kr = sm_uc_call(uc, SM_SEL_SUBMIT, &sub, sizeof(sub), &sub, sizeof(sub));
+	ntest++;
+	ok = (kr == kIOReturnBadArgument);
+	if (ok) nok++; else nbad++;
+	SM_LOG("%s SUBMIT after close: kr=%x\n", ok ? "ok " : "BAD", kr);
+
+	/* 14: and the second BO closes too */
+	memset(&cl, 0, sizeof(cl));
+	cl.handle = h1;
+	kr = sm_uc_call(uc, SM_SEL_CLOSE_BO, &cl, sizeof(cl), NULL, 0);
+	ntest++;
+	ok = (kr == kIOReturnSuccess);
+	if (ok) { nok++; have1 = false; } else nbad++;
+	SM_LOG("%s CLOSE_BO 1: kr=%x\n", ok ? "ok " : "BAD", kr);
+
+out:
+	if (have0) {
+		sm_bo_destroy(h0);
+	}
+	if (have1) {
+		sm_bo_destroy(h1);
+	}
+	SM_LOG("%s (%u/%u%s)\n", (nok == ntest && nbad == 0) ? "PASS" : "FAIL",
+	    nok, ntest, nbad ? ", see BAD lines above" : "");
+}
