+/*
+ * ---------------------------------------------------------------------------
+ * D2: the same BOs, addressed the way a client addresses them
+ * ---------------------------------------------------------------------------
+ *
+ * A client does not know the probe suite's slot numbers, so `sm_bo_create`
+ * hands out the first free handle and the handle is the table index, the
+ * same shape as a GEM handle.  `sm_bo_close` keeps the VA in the freed
+ * handle on purpose: a SUBMIT that still names the old address is refused
+ * instead of quietly reaching whatever the allocator hands out next.
+ *
+ * `sm_bo_kva` is the self-test's access to the BO in D2.  It is not part of
+ * the ABI and userspace never sees it: a real client gets its own mapping in
+ * B2/F1 through IOConnectMapMemory64, and that mapping is what makes the
+ * descriptor "client-built" for a process rather than for the kernel thread.
+ */
+int
+sm_bo_create(uint64_t size, uint32_t *handle)
+{
+	uint32_t slot;
+
+	if (handle == NULL || size == 0 ||
+	    (size & (uint64_t)(SM_GPU_PAGE_SIZE - 1u)) != 0 ||
+	    size > SM_VA_AREA_SIZE || !sm.ready) {
+		return -1;
+	}
+	for (slot = 0; slot < SM_BO_MAX; slot++) {
+		if (!sm.bo[slot].used) {
+			break;
+		}
+	}
+	if (slot == SM_BO_MAX) {
+		return -2;
+	}
+	if (sm_bo_open(slot, size) != 0) {
+		return -3;
+	}
+	*handle = slot;
+	return 0;
+}
+
+int
+sm_bo_destroy(uint32_t handle)
+{
+	if (handle >= SM_BO_MAX || !sm.bo[handle].used) {
+		return -1;
+	}
+	sm_bo_close(handle);
+	return 0;
+}
+
+int
+sm_bo_present(uint32_t handle)
+{
+	return (handle < SM_BO_MAX && sm.bo[handle].used) ? 1 : 0;
+}
+
+/*
+ * The user client calls this from clientClose().  D2 still has one global
+ * handle table, so "all" means every BO in it; with the single client the
+ * probe suite has, that is exactly the client's set.  A per-client table is
+ * part of the same work as MMAP_BO, because that is when two clients can
+ * hold BOs at the same time.
+ */
+void
+sm_bo_close_all(void)
+{
+	uint32_t slot;
+
+	for (slot = 0; slot < SM_BO_MAX; slot++) {
+		if (sm.bo[slot].used) {
+			sm_bo_close(slot);
+		}
+	}
+}
+
+void *
+sm_bo_kva(uint32_t handle)
+{
+	if (handle >= SM_BO_MAX || !sm.bo[handle].used) {
+		return NULL;
+	}
+	return (void *)sm.bo[handle].kva;
+}
