+/*
+ * D2: submit a job descriptor the *client* built.
+ *
+ * The descriptor is neither copied nor touched.  `jc` is a GPU VA inside one
+ * of the listed BOs; the only thing this function does to those BOs is cache
+ * maintenance -- clean before the job so the GPU sees the client's writes,
+ * clean+invalidate after it so the CPU sees the GPU's.  That split is the
+ * point of the stage: everything the hardware reads (job header, target
+ * address, immediate) comes from memory the client filled.
+ *
+ * The handle list is also the validation set: `jc` must lie in one of the
+ * listed BOs, so a client cannot submit a descriptor from memory it does not
+ * own.  The GPU would fault on it anyway, but a refused call is a better
+ * answer than a fault.  D2 does not parse the descriptor for further
+ * resources, so a pointer to an *unlisted* BO is the client's risk until D3
+ * pins resources the way panfrost's submit does.
+ */
+int
+sm_client_submit(uint64_t jc, const uint32_t *handles, uint32_t count,
+    uint32_t *rawstat)
+{
+	struct sm_bo *jb = NULL;
+	uint32_t status;
+	uint32_t i;
+
+	if (!sm.ready || sm.gpu == 0) {
+		return SM_SUBMIT_ENOTREADY;
+	}
+	if (handles == NULL || count == 0 || count > SM_SUBMIT_MAX_BOS ||
+	    (jc & 3ull) != 0) {
+		return SM_SUBMIT_EBADARG;
+	}
+	for (i = 0; i < count; i++) {
+		uint32_t h = handles[i];
+		struct sm_bo *bo;
+
+		if (h >= SM_BO_MAX || !sm.bo[h].used) {
+			return SM_SUBMIT_EBADARG;
+		}
+		bo = &sm.bo[h];
+		if (jb == NULL && jc >= bo->gpu_va &&
+		    jc < bo->gpu_va + bo->size) {
+			jb = bo;
+		}
+	}
+	if (jb == NULL) {
+		return SM_SUBMIT_EJC;
+	}
+	/*
+	 * The smallest descriptor in this driver (the write-value job) is 16
+	 * words = 64 bytes; requiring the whole header inside the BO turns a
+	 * descriptor at the very last word into a refusal here rather than a
+	 * fetch fault from the job front-end.
+	 */
+	if (jc + 64ull > jb->gpu_va + jb->size) {
+		return SM_SUBMIT_EJC;
+	}
+
+	for (i = 0; i < count; i++) {
+		sm_cache_clean_invalidate(sm.bo[handles[i]].kva,
+		    sm.bo[handles[i]].size);
+	}
+	/*
+	 * JS_HEAD is a GPU address: the job front-end fetches the descriptor
+	 * through the AS's MMU, exactly as panfrost's panfrost_job_hw_submit()
+	 * writes job->jc (a VA) and never translates it.  The probe suite's
+	 * submits pass PAs, but those pages are identity-mapped, so a PA is a
+	 * VA there too; a client BO at a non-identity VA has to go in as the
+	 * VA, which is the path this stage exists to prove.
+	 */
+	status = sm_job_submit(jc, SM_JS_CONFIG_BASE | SM_JS_CONFIG_START_MMU,
+	    sm.shader_present, 0);
+	for (i = 0; i < count; i++) {
+		sm_cache_clean_invalidate(sm.bo[handles[i]].kva,
+		    sm.bo[handles[i]].size);
+	}
+	if (rawstat != NULL) {
+		*rawstat = status;
+	}
+	if (status & (1u << 16)) {
+		printf("SWEETMALI: SUBMIT fault rawstat=%x js=%x mmu=%x "
+		    "addr=%x%x\n", status,
+		    sm_rd(sm.gpu + SM_JS_STATUS(0)),
+		    sm_rd(sm.gpu + SM_MMU_INT_RAWSTAT),
+		    sm_rd(sm.gpu + SM_AS_FAULTADDRESS_HI(0)),
+		    sm_rd(sm.gpu + SM_AS_FAULTADDRESS_LO(0)));
+		return SM_SUBMIT_EGPUFAULT;
