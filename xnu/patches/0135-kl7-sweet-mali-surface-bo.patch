+/*
+ * E: the display's own surface.
+ *
+ * Two references name the panel surface: the framebuffer's fSurface and this
+ * clamp.  The second exists because a surface BO can outlive the client that
+ * made it -- the kernel's self-test holds one across the whole stage, and a
+ * future compositor will hold one for as long as it has a render target --
+ * and because the pixels must not be freed while the panel is still scanning
+ * them out.  The clamp is never dropped: it is the display's, and the display
+ * lives as long as the kernel does.
+ */
+static SweetSurface *sweet_default_surface;
+
+void
+sweet_surface_set_default(SweetSurface *s)
+{
+	SweetSurface *old;
+
+	if (s == NULL) {
+		return;
+	}
+	sweet_surface_init_lock();
+	IOLockLock(sweet_surface_lock);
+	old = sweet_default_surface;
+	if (old != s) {
+		s->retain();
+		sweet_default_surface = s;
+	} else {
+		old = NULL;
+	}
+	IOLockUnlock(sweet_surface_lock);
+	/* Only reachable if the display ever changes surface; kept correct so a
+	 * second one cannot leak the first. */
+	if (old != NULL) {
+		old->release();
+	}
+}
+
+SweetSurface *
+sweet_surface_default(void)
+{
+	SweetSurface *s;
+
+	if (sweet_surface_lock == NULL) {
+		return NULL;
+	}
+	IOLockLock(sweet_surface_lock);
+	s = sweet_default_surface;
+	if (s != NULL) {
+		s->retain();
+	}
+	IOLockUnlock(sweet_surface_lock);
+	return s;
+}
