+			 * Only the round-page tail [bpr*height, allocSize) is
+			 * outside the scanned rows, so this proves the write
+			 * without touching a visible pixel.
+			 */
+			sm_e_write(uc, hD, vaD, hP, vaP + poff, SM_E_VALUE1,
+			    pkva + poff, &r);
+			ntest++;
+			ok = sm_e_wrote(&r, SM_E_VALUE1);
+			if (ok) nok++; else nbad++;
+			SM_LOG("%s SUBMIT -> panel tail[%llu]=%llx want=%llx "
+			    "rawstat=%x kr=%x\n", ok ? "ok " : "BAD",
+			    (unsigned long long)poff,
+			    (unsigned long long)r.readback,
+			    (unsigned long long)SM_E_VALUE1, r.rawstat,
+			    r.submit_kr);
+		} else {
+			SM_LOG("stage E: no unscanned tail (%u visible of %u), "
+			    "panel write skipped\n", visible, panel->allocSize);
+		}
+	}
+
+	memset(&cl, 0, sizeof(cl));
+	cl.handle = hP;
+	kr = sm_uc_call(uc, SM_SEL_CLOSE_BO, &cl, sizeof(cl), NULL, 0);
+	ntest++;
+	ok = (kr == kIOReturnSuccess &&
+	    (vaP == 0 || sm_va_mapped(vaP) == 0));
+	if (ok) { nok++; haveP = false; } else nbad++;
+	SM_LOG("%s CLOSE_BO panel BO kr=%x, no PTE at %llx\n",
+	    ok ? "ok " : "BAD", kr, (unsigned long long)vaP);
