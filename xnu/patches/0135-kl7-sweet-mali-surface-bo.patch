+	if (!haveD) {
+		goto out;
+	}
+	memset(&g, 0, sizeof(g));
+	g.handle = hD;
+	kr = sm_uc_call(uc, SM_SEL_GET_BO_OFFSET, &g, sizeof(g), &g, sizeof(g));
+	ntest++;
+	ok = (kr == kIOReturnSuccess && g.offset != 0);
+	if (ok) { nok++; vaD = g.offset; } else nbad++;
+	SM_LOG("%s descriptor va=%llx kr=%x\n", ok ? "ok " : "BAD",
