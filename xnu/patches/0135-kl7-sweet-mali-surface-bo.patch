+	chk = sweet_surface_copy(panel->id);
+	ntest++;
+	ok = (chk != NULL);
+	OSSafeReleaseNULL(chk);
+	if (ok) nok++; else nbad++;
+	SM_LOG("%s panel surface still published after the close\n",
+	    ok ? "ok " : "BAD");
+
+out:
+	if (have0) {
+		sm_e_close(uc, h0);
+	}
+	if (have1) {
+		sm_e_close(uc, h1);
+	}
+	if (have2) {
+		sm_e_close(uc, h2);
+	}
+	if (haveD) {
+		sm_e_close(uc, hD);
