+/* ------------------------------------------------------------------ *
+ * Stage E: an IOSurface's pixels as a BO
+ * ------------------------------------------------------------------ */
+
+/*
+ * What the job writes, where in the surface it writes, and the sentinel the
+ * CPU puts there first: the same write-value job D2 submits, with the target
+ * now inside an IOSurface.  The offset is inside the surface's first page and
+ * away from where any geometry would put a pixel row, so a match at that byte
+ * is the GPU having written the page.
+ */
+#define SM_E_VALUE1     0x0f0f0f0f0f0f0f0full
+#define SM_E_VALUE2     0xf0f0f0f0f0f0f0f0ull
+#define SM_E_VALUE3     0x1234abcd5678ef90ull
+#define SM_E_OFF        0x100u
+#define SM_E_SENTINEL   SM_D2_SENTINEL
+
+/*
+ * IOSurface.framework's lock result: the size the surface door answers and the
+ * fields of sweet_surface_fill_result() this stage reads.  The offsets are the
+ * door's ABI, so they are named here rather than spelled out at each use.
+ */
+#define SM_E_RESULT_SIZE    0xa68u
+#define SM_E_RESULT_PIXELS  0x00u
+#define SM_E_RESULT_ID      0x18u
+#define SM_E_RESULT_ALLOC   0x1cu
+#define SM_E_RESULT_W       0x20u
+#define SM_E_RESULT_H       0x24u
+#define SM_E_RESULT_BPR     0x28u
+#define SM_E_SEL_CREATE     0u      /* kSweetSurfaceCreate */
+#define SM_E_SURFACE_ROOT   "IOCoreSurfaceRoot"
+
+/*
+ * The property dictionary IOSurface.framework sends for a BGRA8 256x256
+ * surface with a 1024-byte row.  XML, because OSUnserializeXML() is what the
+ * door parses and it needs no plist writer behind it; 'BGRA' is 0x42475241
+ * (1111970369), the little-endian spelling of the four bytes a compositor
+ * means by "BGRA".
+ */
+static const char sm_e_props[] =
+	"<dict>"
+	"<key>IOSurfaceWidth</key><integer>256</integer>"
+	"<key>IOSurfaceHeight</key><integer>256</integer>"
+	"<key>IOSurfaceBytesPerElement</key><integer>4</integer>"
+	"<key>IOSurfaceBytesPerRow</key><integer>1024</integer>"
+	"<key>IOSurfacePixelFormat</key><integer>1111970369</integer>"
+	"</dict>";
+
+static uint32_t
+sm_e_u32(const uint8_t *p, uint32_t off)
+{
+	uint32_t v;
+
+	memcpy(&v, p + off, sizeof(v));
+	return v;
+}
+
+static uint64_t
+sm_e_u64(const uint8_t *p, uint32_t off)
+{
+	uint64_t v;
+
+	memcpy(&v, p + off, sizeof(v));
+	return v;
+}
+
+/* Close a handle through the door, ignoring the answer; used by the cleanup. */
+static void
+sm_e_close(IOUserClient *uc, uint32_t handle)
+{
+	struct sm_close_bo cl;
+
+	if (handle == 0) {
+		return;
+	}
+	memset(&cl, 0, sizeof(cl));
+	cl.handle = handle;
+	sm_uc_call(uc, SM_SEL_CLOSE_BO, &cl, sizeof(cl), NULL, 0);
+}
+
+/*
+ * Create a surface the way the frameworks do: open IOCoreSurfaceRoot, send it
+ * the property dictionary, and keep the lock result.  Field +0x00 of that
+ * result is the caller's own mapping of the pixels -- the window
+ * IOSurface.framework would hand an application -- and it is what the checks
+ * below read the GPU's write through.
+ *
+ * The client is deliberately left open: the mapping and the surface's creator
+ * user count live in it, so the stage keeps it until the end.  A surface whose
+ * last client has gone is dropped from the table, and the checks after the
+ * close would then be asking about a different surface.
+ */
+static IOUserClient *
+sm_e_surface_create(uint8_t *result, uint32_t *id_out)
+{
+	OSDictionary *match = IOService::serviceMatching(SM_E_SURFACE_ROOT);
+	IOService *svc;
+	IOUserClient *surf_uc = NULL;
+	IOExternalMethodArguments args;
+	kern_return_t kr;
+
+	if (match == NULL) {
+		SM_LOG("surface: serviceMatching failed\n");
+		return NULL;
+	}
+	svc = IOService::waitForService(match);	/* consumes the dictionary */
+	if (svc == NULL) {
+		SM_LOG("surface: %s not found\n", SM_E_SURFACE_ROOT);
+		return NULL;
+	}
+	kr = svc->newUserClient(current_task(), NULL, 0u, NULL, &surf_uc);
+	if (kr != kIOReturnSuccess || surf_uc == NULL) {
+		SM_LOG("surface: client kr=%x\n", kr);
+		return NULL;
+	}
+	memset(result, 0, SM_E_RESULT_SIZE);
+	memset(&args, 0, sizeof(args));
+	args.version = kIOExternalMethodArgumentsCurrentVersion;
+	args.structureInput = sm_e_props;
+	/*
+	 * The size includes the terminating NUL.  OSUnserializeXML() -- the
+	 * standard kernel entry point the door parses with -- requires an XML
+	 * buffer to be terminated *within* the size it is given (it answers NULL
+	 * when buffer[size - 1] != 0) and the door reports that as "bad property
+	 * dictionary".  Quoting the string as so many characters, which is the
+	 * first thing to reach for, is therefore the one thing that cannot work;
+	 * sizeof includes the terminator, which is what the parser checks for.
+	 */
+	args.structureInputSize = (uint32_t)sizeof(sm_e_props);
+	args.structureOutput = result;
+	args.structureOutputSize = SM_E_RESULT_SIZE;
+	kr = SM_UC_CALL(surf_uc, SM_E_SEL_CREATE, &args);
+	if (kr != kIOReturnSuccess) {
+		SM_LOG("surface: create kr=%x\n", kr);
+		surf_uc->clientClose();
+		surf_uc->release();
+		return NULL;
+	}
+	*id_out = sm_e_u32(result, SM_E_RESULT_ID);
+	return surf_uc;
+}
+
+/* What one write-value round trip through a surface BO produced. */
+struct sm_e_round {
+	IOReturn submit_kr;
+	uint32_t rawstat;
+	IOReturn sync_kr;
+	uint64_t readback;
+};
+
+/*
+ * One round trip: build the write-value job in the descriptor BO, poison the
+ * target byte, submit with both BOs listed, sync the target's cache and read
+ * it back through the CPU.  The poison is what makes the readback mean
+ * something -- a job that never ran leaves the sentinel, and the check that
+ * sees the value is the check that saw the GPU write.
+ *
+ * The descriptor goes out with an explicit cache clean, the handover D2 makes
+ * implicitly: the GPU is not coherent with the CPU, so a dirty descriptor line
+ * is a job the hardware reads as zeros.
+ */
+static void
+sm_e_write(IOUserClient *uc, uint32_t desc_bo, uint64_t jc, uint32_t target_bo,
+    uint64_t target_va, uint64_t value, uintptr_t target_kva,
+    struct sm_e_round *r)
+{
+	volatile uint32_t *desc = (volatile uint32_t *)sm_bo_kva(desc_bo);
+	struct sm_sync_bo syn;
+	struct sm_submit sub;
+	IOReturn kr;
+
+	memset(r, 0, sizeof(*r));
+	if (desc == NULL || target_kva == 0) {
+		return;
+	}
+	sm_d3_job(desc, target_va, value);
+	*(volatile uint64_t *)target_kva = SM_E_SENTINEL;
+
+	memset(&syn, 0, sizeof(syn));
+	syn.handle = desc_bo;
+	syn.type = SM_BO_SYNC_CPU_CACHE_FLUSH;
+	kr = sm_uc_call(uc, SM_SEL_SYNC_BO, &syn, sizeof(syn), NULL, 0);
+	if (kr != kIOReturnSuccess) {
+		SM_LOG("stage E: descriptor flush kr=%x\n", kr);
+	}
+
+	sm_uc_submit_init(&sub);
+	sub.jc = jc;
+	sub.bo_count = 2;
+	sub.bo_handles[0] = desc_bo;
+	sub.bo_handles[1] = target_bo;
+	r->submit_kr = sm_uc_call(uc, SM_SEL_SUBMIT, &sub, sizeof(sub), &sub,
+	    sizeof(sub));
+	r->rawstat = sub.rawstat;
+
+	memset(&syn, 0, sizeof(syn));
+	syn.handle = target_bo;
+	syn.type = SM_BO_SYNC_CPU_CACHE_FLUSH_AND_INVALIDATE;
+	r->sync_kr = sm_uc_call(uc, SM_SEL_SYNC_BO, &syn, sizeof(syn), NULL, 0);
+	r->readback = *(volatile uint64_t *)target_kva;
+}
+
+/* Did the round trip run, finish, and leave `value` in the target's memory? */
+static bool
+sm_e_wrote(const struct sm_e_round *r, uint64_t value)
+{
+	return r->submit_kr == kIOReturnSuccess && (r->rawstat & 1u) != 0 &&
+	    (r->rawstat & (1u << 16)) == 0 && r->sync_kr == kIOReturnSuccess &&
+	    r->readback == value;
+}
+
+/*
+ * Stage E's checks.  The claim is one sentence -- the GPU writes the
+ * IOSurface's own pixels, and the CPU sees it there -- and every check below
+ * is a way the claim could be false: the pages not mapped, the mapping not the
+ * surface's memory, the close leaving a stale PTE, the memory freed while the
+ * display still scans it, the second buffer a compositor keeps not being the
+ * same pixels.
+ */
+static void
+sweet_mali_uc_test_e(IOUserClient *uc)
+{
+	struct sm_surface_bo sb;
+	struct sm_create_bo c;
+	struct sm_get_bo_offset g;
+	struct sm_mmap_bo mm;
+	struct sm_close_bo cl;
+	struct sm_submit sub;
+	struct sm_e_round r;
