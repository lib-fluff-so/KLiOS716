+ *     (kIOReturnUnsupported).  The GPU maps 4 KiB pages; a descriptor that
+ *     answers with a byte offset inside a page has no page to map.  Every
+ *     surface this kernel can hand out today comes from IOSurfaceRoot's
+ *     create(), which allocates a page-aligned kernel buffer, so this is
+ *     about keeping a future wrapped-or-partial surface from being mapped
+ *     wrongly instead of being refused.
+ *
+ * Walking the memory descriptor happens here rather than in the core: an
+ * IOMemoryDescriptor is IOKit's, and what the core takes is an array of
+ * physical addresses.  One getPhysicalSegment() per 4 KiB page is what the
+ * working reference implementation does, and it keeps this loop free of any
+ * assumption about how the descriptor is composed -- it may be one buffer or
+ * a scatter list, and the answer is the same.
+ *
+ * The surface's kernel address goes along as the BO's kernel mapping, so
+ * SYNC_BO and the probe suite's readback need no external-BO code path: they
+ * only ever wanted *an* address for those pages.  What the caller owes the
+ * driver around the handover is SYNC_BO: the pages are cacheable and the GPU
+ * is not coherent.
+ */
+static IOReturn
+sm_uc_surface_bo(SweetMaliUserClient *client, IOExternalMethodArguments *args)
+{
+	struct sm_surface_bo r;
+	SweetSurface *s;
+	uint64_t size, *pas = NULL, off;
+	uintptr_t kva;
+	uint32_t pages, n = 0, handle = 0;
+	int rc;
+
+	if (sm_uc_in(args, &r, sizeof(r)) != kIOReturnSuccess) {
+		return kIOReturnBadArgument;
+	}
+	if (r.handle != 0 && r.handle != SM_SURFACE_DESCRIBE_ONLY) {
+		return kIOReturnBadArgument;
+	}
+	if (!sm_gpu_ready()) {
+		return kIOReturnNotReady;
+	}
+	s = sweet_surface_copy(r.surface_id);
+	if (s == NULL) {
+		return kIOReturnNotFound;
+	}
+	if (s->memory == NULL) {
+		s->release();
+		return kIOReturnUnsupported;
+	}
+	/*
+	 * The geometry goes back on both paths: describing a surface is a
+	 * question about the surface, not about the GPU, and a caller that only
+	 * wants to know how big its render target is should not have to make a
+	 * BO to find out.
+	 */
+	size = ((uint64_t)s->memory->getLength() + SM_BO_PAGE_SIZE - 1) &
+	    ~(uint64_t)(SM_BO_PAGE_SIZE - 1);
+	r.size = size;
+	r.offset = s->offset;
+	r.bytes_per_row = s->bytesPerRow;
+	r.width = s->width;
+	r.height = s->height;
+	r.pixel_format = s->pixelFormat;
+	r.planes = s->planeCount;
+	r.gpu_va = 0;
+	if (r.handle == SM_SURFACE_DESCRIBE_ONLY) {
+		r.handle = 0;
+		s->release();
+		return sm_uc_out(args, &r, sizeof(r));
+	}
+	if (size == 0) {
+		s->release();
+		return kIOReturnBadArgument;
+	}
+	kva = s->kernelAddress();
+	if (kva == 0) {
+		SM_LOG("surface %u: no kernel address for %llu bytes\n",
+		    r.surface_id, (unsigned long long)size);
+		s->release();
+		return kIOReturnUnsupported;
+	}
+	pages = (uint32_t)(size / SM_BO_PAGE_SIZE);
+	pas = (uint64_t *)IOMallocData(sizeof(uint64_t) * pages);
+	if (pas == NULL) {
+		s->release();
+		return kIOReturnNoMemory;
+	}
+	for (off = 0; off < size; off += SM_BO_PAGE_SIZE) {
+		IOByteCount length = 0;
+		addr64_t pa = s->memory->getPhysicalSegment(off, &length,
+		    kIOMemoryMapperNone);
+
+		if (pa == 0 || length == 0 ||
+		    (pa & (SM_BO_PAGE_SIZE - 1)) != 0) {
+			SM_LOG("surface %u: page %u is not mappable (pa %llx "
+			    "len %llu)\n", r.surface_id, n,
+			    (unsigned long long)pa, (unsigned long long)length);
+			IOFreeData(pas, sizeof(uint64_t) * pages);
+			s->release();
+			return kIOReturnUnsupported;
+		}
+		pas[n++] = (uint64_t)pa;
+	}
+	rc = sm_bo_create_external(size, (uint64_t)kva, pas, pages, client,
+	    &handle);
+	IOFreeData(pas, sizeof(uint64_t) * pages);
+	switch (rc) {
+	case 0:
+		break;
+	case -1:
+		s->release();
+		return kIOReturnBadArgument;
+	case -2:
+		s->release();
+		return kIOReturnNoResources;
+	default:
+		s->release();
+		return kIOReturnNoMemory;
+	}
+	/*
+	 * The reference sweet_surface_copy() gave us moves into the table:
+	 * `s` is deliberately not released on this path.  From here the only
+	 * thing that can drop it is CLOSE_BO or clientClose(), both of which
+	 * run after the core has taken the PTEs away.
+	 */
+	client->holdSurface(handle, s);
+	r.handle = handle;
+	r.gpu_va = sm_bo_va(handle);
+	SM_LOG("surface %u as BO %u: va=%llx size=%llu %ux%u bpr=%u "
+	    "off=%u fmt=%#x planes=%u\n", r.surface_id, handle,
+	    (unsigned long long)r.gpu_va, (unsigned long long)r.size,
+	    r.width, r.height, r.bytes_per_row, r.offset, r.pixel_format,
+	    r.planes);
+	return sm_uc_out(args, &r, sizeof(r));
+}
