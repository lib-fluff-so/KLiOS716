+/* How much of the GPU VA area is handed out, for the refusal log below. */
+static uint64_t
+sm_va_used_kb(void)
+{
+	uint64_t pages = 0;
+
+	for (uint32_t i = 0; i < SM_VA_BITMAP_WORDS; i++) {
+		pages += (uint64_t)__builtin_popcount(sm.va_used[i]);
+	}
+	return pages * (SM_GPU_PAGE_SIZE / 1024);
+}
