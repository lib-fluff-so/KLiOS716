+/*
+ * LOG: copy a bounded line to IOLog.  The console ring is the only readback
+ * path the host has (the root is HFS+ and Android cannot mount it), so a
+ * userspace probe's verdict has to travel through the kernel log to survive
+ * the boot.  status is 1 when the line was accepted.
+ */
+static IOReturn
+sm_uc_log(IOExternalMethodArguments *args)
+{
+	struct sm_log l;
+	char text[SM_LOG_MAX + 1];
+	uint32_t n;
+
+	if (sm_uc_in(args, &l, sizeof(l)) != kIOReturnSuccess) {
+		return kIOReturnBadArgument;
+	}
+	n = l.size;
+	if (n > SM_LOG_MAX) {
+		n = SM_LOG_MAX;
+	}
+	if (n == 0) {
+		return kIOReturnBadArgument;
+	}
+	memcpy(text, l.text, n);
+	text[n] = '\0';
+	IOLog("SWEETMALI F1: %s\n", text);
+	l.size = n;
+	l.status = 1;
+	return sm_uc_out(args, &l, sizeof(l));
+}
