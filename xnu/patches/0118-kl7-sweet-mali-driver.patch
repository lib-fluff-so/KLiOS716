+			{ 0xbf400000u, 0x3f800000u, 0x00000000u, 0x3f800000u,
+			  0x3f400000u, 0x3f800000u, 0x00000000u, 0x3f800000u,
+			  0x00000000u, 0x3dccccccu, 0x00000000u, 0x3f800000u },
