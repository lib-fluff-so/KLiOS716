+			printf("SWEETMALI: IDXA %s va=%x vt=%llx vspd=%x:%x "
+			    "code=%x:%x rtab=%x:%x attr=%x:%x abuf=%x:%x "
+			    "tctx=%x:%x fbd=%x:%x heap=%llx fb=%llx\n",
+			    cases[ci].name, cases[ci].va,
+			    (unsigned long long)va_tri, vjob[74], vjob[75],
+			    p_vspd[2], p_vspd[3], vjob[72], vjob[73], p_res[4],
+			    p_res[5], p_res[8], p_res[9], vjob[14], vjob[15],
