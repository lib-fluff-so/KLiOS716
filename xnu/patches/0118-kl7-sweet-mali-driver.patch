+			 * A3/B1: with every pointer edit in, the BO's first
+			 * page gets a byte-exact copy of the descriptor page,
+			 * so the batch reads through the board exactly what it
+			 * would have read through the identity mapping.
+			 */
+			if (cases[ci].va & SM_VA_BO0) {
+				sm_bo_fill(0);
+			} else if (cases[ci].va & SM_VA_BO1) {
+				sm_bo_fill(1);
+			} else if (cases[ci].va & SM_VA_BO2) {
+				sm_bo_fill(2);
+			}
+		}
