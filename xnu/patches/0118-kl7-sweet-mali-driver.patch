+		for (bi = 0; bi < 3u; bi++) {
+			uint32_t *vp = (uint32_t *)(base + SM_TRI_VBUF +
+			    bi * SM_TRI_VBLK);
+			uint32_t *bp = (uint32_t *)(base + SM_TRI_ATTRBUF +
+			    bi * 32u);
+			const uint64_t vpa = base_pa + SM_TRI_VBUF +
+			    bi * SM_TRI_VBLK;
