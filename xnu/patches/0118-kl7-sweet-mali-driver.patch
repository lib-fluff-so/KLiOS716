+/*
+ * SweetMali: Mali-G57 (MT6789, Valhall TNAX) GPU bring-up for XNU.
+ *
+ * This is the first XNU milestone.  It is a direct port of the KL7 shim's
+ * proven power-up path (KLiOS716-shim/src/gpu.c): SCPSYS MFG0..3 MTCMOS,
+ * the MFG1 topaxi protection release, the 26 MHz reference mux, MFGPLL at
+ * 390 MHz, the mfg_pll_sel mux, the BG3D gate, the external clock gates,
+ * a soft reset, and the internal L2/shader/tiler power-on.  It then reads
+ * the GPU_ID/feature registers and logs them.
+ *
+ * The PMIC rails (VGPU/VSRAM_GPU) are intentionally left alone: the
+ * bootloader has already enabled them.  A read-only shim boot measured
+ * them on at ~850 mV before any GPU register was touched.  Voltage
+ * scaling belongs to the later DVFS milestone.
+ *
+ * The second milestone adds the GPU MMU (AS0 with 2 MiB identity blocks)
+ * and submits a write-value job through JS0 with START_MMU, then reads the
+ * value back from the CPU.  No compute/tiler jobs, no user client yet.
+ * Every register sequence is the one the shim already proved on this
+ * phone (KLiOS716-shim/src/gpu.c).
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
