+				p_vspd[3] = (uint32_t)(va_vcode >> 32);
+				p_fspd[2] = (uint32_t)va_fcode;
+				p_fspd[3] = (uint32_t)(va_fcode >> 32);
+			}
+			if (cases[ci].va & SM_VA_DESC) {
