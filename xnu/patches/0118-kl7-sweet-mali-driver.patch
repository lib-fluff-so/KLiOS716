+#define SM_GPU_THREAD_MAX_BARRIER 0x0a8u
+#define SM_GPU_THREAD_FEATURES   0x0acu
+#define SM_GPU_TEXTURE_FEATURES(n) (0x0b0u + (n) * 4u)
+#define SM_GPU_JS_FEATURES(n)    (0x0c0u + (n) * 4u)
+#define SM_GPU_AFBC_FEATURES     0x04cu
+#define SM_GPU_SHADER_PRESENT_LO 0x100u
+#define SM_GPU_TILER_PRESENT_LO  0x110u
+#define SM_GPU_L2_PRESENT_LO     0x120u
+#define SM_GPU_COHERENCY_FEATURES 0x300u
+#define SM_GPU_THREAD_TLS_ALLOC  0x310u
+#define SM_GPU_STACK_PRESENT_LO  0xe00u
+#define SM_GPU_SHADER_READY_LO   0x140u
