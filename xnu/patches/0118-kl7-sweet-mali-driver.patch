+				vjob[15] = (uint32_t)(va_tctx >> 32);
+				vjob[42] = (uint32_t)va_ds;
+				vjob[43] = (uint32_t)(va_ds >> 32);
+				vjob[44] = 1u |
+				    ((uint32_t)(va_blnd >> 4) << 4);
+				vjob[45] = (uint32_t)((va_blnd >> 4) >> 28);
+				vjob[56] = (uint32_t)va_rtab;
+				vjob[57] = (uint32_t)(va_rtab >> 32);
+				vjob[58] = (uint32_t)va_fspd;
+				vjob[59] = (uint32_t)(va_fspd >> 32);
+				vjob[60] = (uint32_t)va_tls;
+				vjob[61] = (uint32_t)(va_tls >> 32);
+				vjob[62] = (uint32_t)va_tls;
+				vjob[63] = (uint32_t)(va_tls >> 32);
+				vjob[72] = (uint32_t)va_rtab;
+				vjob[73] = (uint32_t)(va_rtab >> 32);
+				vjob[74] = (uint32_t)va_vspd;
+				vjob[75] = (uint32_t)(va_vspd >> 32);
+				vjob[76] = (uint32_t)va_tls;
+				vjob[77] = (uint32_t)(va_tls >> 32);
+				vjob[78] = (uint32_t)va_tls;
+				vjob[79] = (uint32_t)(va_tls >> 32);
+				frag[10] = (uint32_t)va_fbd;
+				frag[11] = (uint32_t)(va_fbd >> 32);
+				p_fbd[14] = (uint32_t)va_tctx;
+				p_fbd[15] = (uint32_t)(va_tctx >> 32);
+				p_tctx[6] = (uint32_t)va_heapdesc;
+				p_tctx[7] = (uint32_t)(va_heapdesc >> 32);
+			}
+			if (cases[ci].va & SM_VA_TBL) {
+				p_res[1 * 4u + 0u] = (uint32_t)va_attr;
+				p_res[1 * 4u + 1u] =
