+/* Depth/stencil descriptor: the fragment pass always fetches one. */
+static const uint32_t sm_ds_null[8] = {
+	0x00070077u, 0xffffffffu, 0x00000000u, 0x00000000u,
+	0xe4c00000u, 0x00000000u, 0x00000000u, 0x00000000u,
+};
+
+static uint32_t
+sm_job_submit(uint64_t job_pa, uint32_t cfg, uint32_t affinity, uint32_t slot)
+{
+	uint32_t status = 0;
+	uint32_t i;
+
+	sm_wr(sm.gpu + SM_JOB_INT_MASK, 0);
+	sm_wr(sm.gpu + SM_JOB_INT_CLEAR, 0xffffffffu);
+	sm_wr(sm.gpu + SM_MMU_INT_CLEAR, 0xffffffffu);
+
+	sm_wr(sm.gpu + SM_JS_HEAD_NEXT_LO(slot), (uint32_t)job_pa);
+	sm_wr(sm.gpu + SM_JS_HEAD_NEXT_HI(slot), (uint32_t)(job_pa >> 32));
+	sm_wr(sm.gpu + SM_JS_AFFINITY_NEXT_LO(slot), affinity);
+	sm_wr(sm.gpu + SM_JS_AFFINITY_NEXT_HI(slot), 0);
+	sm_wr(sm.gpu + SM_JS_CONFIG_NEXT(slot), cfg);
+	sm_wr(sm.gpu + SM_JS_COMMAND_NEXT(slot), SM_JS_COMMAND_START);
+
+	for (i = 0; i < SM_TIMEOUT_STEPS; i++) {
+		status = sm_rd(sm.gpu + SM_JOB_INT_RAWSTAT);
+		if (status & ((1u << slot) | (1u << (16u + slot)))) {
+			break;
+		}
+		delay(SM_TIMEOUT_US);
+	}
+	sm_wr(sm.gpu + SM_JOB_INT_CLEAR, status);
+	return status;
+}
+
+/*
+ * Render the shim's proven triangle straight into the real panel
+ * framebuffer.  Same fixed configuration the shim used for its panel demo:
+ * all vertex-job sections, compact descriptor layout, 32 MiB tiler heap,
+ * IDVS job on JS1, fragment job on JS0, both with START_MMU.
+ */
+/*
+ * Read one pixel back through the CPU.  The panel framebuffer is far larger
+ * than the kernel's 8 MiB io_submap, so map only the 4 KiB page holding the
+ * requested pixel and read inside it.
+ */
+static uint32_t
+sm_fb_read_pixel(uint64_t fb_pa, uint32_t stride, uint32_t row, uint32_t col)
+{
+	uint64_t off = (uint64_t)row * stride + (uint64_t)col * 4u;
+	vm_offset_t va;
+
+	va = ml_io_map((vm_offset_t)((fb_pa + off) & ~0xfffull),
+	    SM_GPU_PAGE_SIZE);
+	if (!va) {
+		return 0xffffffffu;
+	}
+	return *(volatile uint32_t *)(va + (off & 0xfffull));
+}
+
+/*
+ * Write one pixel through the CPU, used to poison the probe pixels before a
+ * draw so "the triangle was not rasterised" cannot be confused with stale
+ * paint left by an earlier case.
+ */
+static void
+sm_fb_write_pixel(uint64_t fb_pa, uint32_t stride, uint32_t row, uint32_t col,
+    uint32_t value)
+{
+	uint64_t off = (uint64_t)row * stride + (uint64_t)col * 4u;
+	vm_offset_t va;
+
+	va = ml_io_map((vm_offset_t)((fb_pa + off) & ~0xfffull),
+	    SM_GPU_PAGE_SIZE);
+	if (!va) {
+		return;
+	}
+	*(volatile uint32_t *)(va + (off & 0xfffull)) = value;
+}
+
+/*
+ * A rejected job (JS_STATUS 0x58 DATA_INVALID_FAULT) stops the job slot and
+ * every later submission on it fails the same way.  The shim proved that a
+ * full "case reset" (GPU soft reset + G57 quirks + power units + AS0 reload)
+ * is what makes a battery of cases independent, so every probe case that
+ * follows a possible fault starts from that exact state.
+ */
+static int
+sm_case_reset(void)
+{
+	uint32_t acp_before;
+	uint32_t acp_after;
+	int rc;
+
+	acp_before = sm_rd(sm.infra + SM_MFG_SLAVE_GALS_CTRL);
+	rc = sm_soft_reset();
+	if (rc) {
+		return rc;
+	}
+	sm_apply_g57_quirks();
+	rc = sm_power_units_on();
+	if (rc) {
+		return rc;
+	}
+	rc = sm_mmu_configure_as(0, sm.tables_pa);
+	if (rc) {
+		return rc;
+	}
+	/*
+	 * A soft reset clears every address space's registers, so AS1 has to
+	 * be re-pointed at its own table set too, exactly as AS0 is.  The
+	 * page tables in memory are untouched by a reset.
+	 */
+	rc = sm_mmu_configure_as(1, sm.as1_tables_pa);
+	if (rc) {
+		return rc;
+	}
+	/*
+	 * MediaTek's broken MFG->ACP route is what makes every job fault with
+	 * DATA_INVALID_FAULT, so re-assert the disable and show whether the
+	 * reset/power sequence re-enabled it behind our back.
+	 */
+	acp_after = sm_rd(sm.infra + SM_MFG_SLAVE_GALS_CTRL);
+	sm_disable_acp();
+	printf("SWEETMALI: IDX ACP reset before=%x after=%x bit9=%u/%u\n",
+	    acp_before, acp_after, (acp_before >> SM_DIS_MFG2ACP_BIT) & 1u,
+	    (acp_after >> SM_DIS_MFG2ACP_BIT) & 1u);
+	return 0;
+}
+
+/*
+ * One exact copy of the batch the case loop calls "base": cache flush on
+ * slot 0, vertex job on slot 1, fragment job on slot 0, with the same field
+ * setup and the same cache maintenance.  Everything that is printed comes
+ * straight from the hardware.
+ */
+/*
+ * The hardware stores the per-job exception status in words 0..3 of the job
+ * header and refuses to start a job whose word 0 is already non-zero (the
+ * fault pointer then points at the header itself, exception 0x10258).  So a
+ * header can only be reused after its status words have been cleared.
+ */
+/*
+ * The whole descriptor page, byte for byte, as the builder left it.  Every
+ * round after the first restores this, so any difference the hardware makes
+ * is either visible in the diff or has no effect at all.
+ */
+static uint32_t sm_snap[1024];
+
+static void
+sm_snap_take(void)
+{
+	volatile uint32_t *p = (volatile uint32_t *)sm.tri;
+	uint32_t i;
+
+	for (i = 0; i < 1024u; i++) {
+		sm_snap[i] = p[i];
+	}
+}
+
+static void
+sm_snap_restore(void)
+{
+	volatile uint32_t *p = (volatile uint32_t *)sm.tri;
+	uint32_t i;
+
+	for (i = 0; i < 1024u; i++) {
+		p[i] = sm_snap[i];
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+	sm_cache_clean_invalidate(sm.tri, SM_GPU_PAGE_SIZE);
+}
+
+static void
+sm_snap_diff(const char *tag)
+{
+	volatile uint32_t *p = (volatile uint32_t *)sm.tri;
+	uint32_t n = 0;
+	uint32_t i;
+
+	for (i = 0; i < 1024u; i++) {
+		if (p[i] != sm_snap[i]) {
+			n++;
+			if (n <= 20u) {
+				printf("SWEETMALI: DIFF %s off=%x old=%x new=%x\n",
+				    tag, i * 4u, sm_snap[i], p[i]);
+			}
+		}
+	}
+	printf("SWEETMALI: DIFF %s total=%u\n", tag, n);
+}
+
+static int
+sm_triangle_demo(void)
+{
+	uint8_t *base = (uint8_t *)sm.tri;
