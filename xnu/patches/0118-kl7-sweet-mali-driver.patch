+			printf("SWEETMALI: IDX %s SKIP action failed\n",
+			    cases[ci].name);
+			continue;
+		}
+
+		/*
+		 * Recompute the batch's page-internal addresses for this
+		 * case: the fixed VA window by default, or the VA the BO /
+		 * guard cases name (an address the allocator chose, not a
+		 * constant, and for BO1 a different one from BO0).
+		 */
+		va_tri = sm_case_va_base(cases[ci].va);
+		if (!va_tri) {
+			va_tri = SM_VAW_TRI +
+			    (sm.tri_pa & (SM_MALI_BLOCK_2M - 1ull));
+		}
+		va_vspd = va_tri + SM_TRI_VSPD;
+		va_fspd = va_tri + SM_TRI_FSPD;
+		va_vcode = va_tri + SM_TRI_VSCODE;
+		va_fcode = va_tri + SM_TRI_FSCODE;
+		va_res = va_tri + SM_TRI_RES;
+		va_ds = va_tri + SM_TRI_DS_OFF;
+		va_blnd = va_tri + SM_TRI_BLND;
+		va_attr = va_tri + SM_TRI_ATTR;
+		va_abuf = va_tri + SM_TRI_ATTRBUF;
+		va_heapdesc = va_tri + SM_TRI_HEAP;
+		va_tctx = va_tri + SM_TRI_TCTX;
+		va_fbd = (va_tri + SM_TRI_FBD) | 1u;
+		va_tls = va_tri + 0xf00u;
+
+		if (cases[ci].zero == 2u) {
+			/*
+			 * Control case: fake the leftover the hardware would
+			 * have written and show that the job is refused.
+			 */
+			vjob[0] = 1u;
+		}
+
+		if (cases[ci].vsattr) {
+			/*
+			 * vsattr 1 = attribute VS, 2 = panel VS (control for
+			 * the preload bits), 3 = attribute VS with the panel
+			 * preload mask.
+			 */
+			if (cases[ci].vsattr != 2u) {
+				sm_shader_copy(vcode, &sm_sh_attr_vs);
+			}
+			/*
+			 * The attribute VS preloads r59..r61, the panel VS
+			 * only r59..r60; both descriptors are packed from the
+			 * same metadata, only the preload field differs.
+			 */
+			{
+				struct sm_shader sh = sm_sh_attr_vs;
+
+				if (cases[ci].vsattr == 3u) {
+					sh.preload = sm_sh_panel_vs.preload;
+				}
+				sm_shader_pack(vspd, &sh, vcode_a);
+			}
+			{
+				/*
+				 * Format/stride variants.  vbi bits 12..15
+				 * pick the Format encoding, bit 16 selects
+				 * stride 0 instead of 16.
+				 */
+				uint32_t *va3 = (uint32_t *)(base + SM_TRI_ATTR);
+				uint32_t pix;
+
+				switch ((cases[ci].vbi >> 12) & 0xfu) {
+				case SM_FMT_SNAP4:
+					pix = 94u << 12;
+					break;
+				case SM_FMT_BARE:
+					pix = 191u;
+					break;
+				case SM_FMT_ZERO:
+					pix = 0u;
+					break;
+				default:
+					pix = SM_ATTR_PIXFMT;
+					break;
+				}
+				va3[0] = 5u | (1u << 4) | (1u << 8) |
+				    (pix << 10);
+				va3[3] = cases[ci].vbi & 0xffu;
+				va3[4] = (cases[ci].vbi & 0x10000u) ? 0u : 16u;
+			}
+			if (cases[ci].vbi & 0x100u) {
+				/*
+				 * A/B: the attribute fetch may be served by
+				 * the Varying shader environment's resource
+				 * table instead of the Position one.
+				 */
+				vjob[88] = (uint32_t)rtab;
+				vjob[89] = (uint32_t)(rtab >> 32);
+			}
+			{
+				uint32_t *rr = (uint32_t *)(base + SM_TRI_RES);
+				uint32_t *aa = (uint32_t *)(base + SM_TRI_ATTR);
+				uint32_t *bb = (uint32_t *)(base + SM_TRI_ATTRBUF);
+
+				printf("SWEETMALI: IDXD %s rtab=%x:%x "
+				    "attr=%x/%x/%x/%x/%x res1=%x:%x/%u "
+				    "res2=%x:%x/%u ab0=%x:%x\n", cases[ci].name,
+				    vjob[72], vjob[73], aa[0], aa[1], aa[2], aa[3],
+				    aa[4], rr[4], rr[5], rr[6], rr[8], rr[9],
+				    rr[10], bb[2], bb[3]);
+			}
+		}
+
+		if (cases[ci].sh) {
+			/*
+			 * C1: put a shader the kernel has never run into the
+			 * page's code slot and pack its descriptor from
+			 * metadata.  This runs after the vsattr block (which
+			 * also names a code blob and packs a descriptor) and
+			 * before the VA block, so a BO case copies the page --
+			 * new code, new descriptor -- into the BO like
+			 * everything else.
+			 */
+			switch (cases[ci].sh) {
+			case SM_SH_FS_BLUE:
+				sm_shader_copy(fcode, &sm_sh_fs_blue);
+				sm_shader_pack(fspd, &sm_sh_fs_blue, fcode_a);
+				break;
+			case SM_SH_VS_OFF:
+				sm_shader_copy(vcode, &sm_sh_vs_off);
+				sm_shader_copy(fcode, &sm_sh_fs_blue);
+				sm_shader_pack(vspd, &sm_sh_vs_off, vcode_a);
+				sm_shader_pack(fspd, &sm_sh_fs_blue, fcode_a);
+				break;
+			case SM_SH_FS_BADSTAGE: {
+				struct sm_shader sh = sm_sh_fs_blue;
+
+				sh.stage = SM_STAGE_VERTEX;
+				sm_shader_copy(fcode, &sm_sh_fs_blue);
+				sm_shader_pack(fspd, &sh, fcode_a);
+				break;
+			}
+			default:
+				break;
+			}
+			printf("SWEETMALI: SHAD %s sh=%u vs=%08x/%08x v=%08x "
+			    "fs=%08x/%08x f=%08x\n", cases[ci].name,
+			    cases[ci].sh, vspd[0], vspd[1], vcode[0], fspd[0],
