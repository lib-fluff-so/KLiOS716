+		vst = 0xdeadbeefu;
+		vjs = 0xdeadbeefu;
+		fjs = 0xdeadbeefu;
+		mmu = 0xdeadbeefu;
+
+		/* Stage the index buffer for this case. */
+		switch (cases[ci].where) {
+		case 1u:
+			idxs = idx_target;
+			idx_a = idx_target_a;
+			break;
+		case 2u:
+			idxs = NULL;
+			idx_a = 0;
+			break;
+		default:
+			idxs = idx_inpage;
+			idx_a = idx_inpage_a;
+			break;
+		}
+		if (idxs) {
+			for (i = 0; i < 3u; i++) {
+				if (cases[ci].type == 1u) {
+					idxs[i] = (uint8_t)cases[ci].v[i];
+				} else if (cases[ci].type == 3u) {
+					((uint32_t *)idxs)[i] = cases[ci].v[i];
+				} else {
+					((uint16_t *)idxs)[i] =
+					    (uint16_t)cases[ci].v[i];
+				}
+			}
+			if (cases[ci].where == 1u) {
+				sm_cache_clean_invalidate(sm.target,
+				    SM_GPU_PAGE_SIZE);
+			}
+		}
+
+		vjob[8] = 8u | (cases[ci].type << 8);
+		if (!(cases[ci].flags & 1u)) {
+			vjob[8] |= 1u << 15;
+		}
+		vjob[13] = (cases[ci].flags & 2u) ? (16u | (16u << 16)) : 16u;
+		vjob[30] = (uint32_t)idx_a;
+		vjob[31] = (uint32_t)(idx_a >> 32);
+
+		{
+			volatile uint32_t *th = (volatile uint32_t *)sm.heap;
+
+			for (i = 0; i < zero / 4u; i++) {
+				th[i] = 0;
+			}
+		}
+		/*
+		 * Poison the three probe pixels.  A case that paints nothing
+		 * must be distinguishable from one whose geometry-less tiles
+		 * were simply not cleared.
+		 */
+		sm_fb_write_pixel(fb_base, fb_stride, 1000u, 540u, 0xdeadbeefu);
+		sm_fb_write_pixel(fb_base, fb_stride, 1900u, 540u, 0xdeadbeefu);
+		sm_fb_write_pixel(fb_base, fb_stride, 2300u, 60u, 0xdeadbeefu);
+		__asm__ volatile("dsb sy" ::: "memory");
+
+		sm_cache_clean_invalidate(sm.tri, SM_GPU_PAGE_SIZE);
+		sm_cache_clean_invalidate(sm.heap, (vm_size_t)zero);
+
+		cfst = sm_job_submit(cflush_a,
+		    SM_JS_CONFIG_BASE | SM_JS_CONFIG_START_MMU | asf,
+		    sm.shader_present, 0);
+		vst = sm_job_submit(vjob_a,
+		    SM_JS_CONFIG_BASE | SM_JS_CONFIG_START_MMU | asf,
+		    sm.shader_present, 1);
+		vjs = sm_rd(sm.gpu + SM_JS_STATUS(1));
+		mmu = sm_rd(sm.gpu + SM_MMU_INT_RAWSTAT);
+		if (!(vst & (1u << (16u + 1u))) && vjs == 0) {
+			sm_job_submit(frag_a,
+			    SM_JS_CONFIG_BASE | SM_JS_CONFIG_START_MMU | asf,
+			    sm.shader_present, 0);
+			fjs = sm_rd(sm.gpu + SM_JS_STATUS(0));
+		}
+		__asm__ volatile("dsb sy" ::: "memory");
+
+		/*
+		 * The "Malloc vertex" job makes the hardware allocate the
+		 * vertex packet buffer and write its (address >> 6) back into
+		 * the Draw vertex-array pointer, and the position shader stores
+		 * its result there.  Reading the buffer therefore shows, per
+		 * vertex, exactly what the vertex shader computed -- the only
+		 * way to see what an attribute fetch actually returned.
+		 */
+		{
+			uint64_t vab = ((uint64_t)((vjob[34] >> 6) & 0x03ffffffu)) |
+			    ((uint64_t)vjob[35] << 26);
+
+			vab <<= 6;
+			sm_cache_clean_invalidate(sm.heap, (vm_size_t)zero);
+			if (vab >= sm.heap_pa &&
+			    vab + 3u * 16u <= sm.heap_pa + sm.heap_size) {
+				const volatile uint32_t *pk =
+				    (const volatile uint32_t *)
+				    (sm.heap + (vm_offset_t)(vab - sm.heap_pa));
+
+				printf("SWEETMALI: IDXV %s vab=%llx "
+				    "p0=%08x%08x%08x%08x p1=%08x%08x%08x%08x "
+				    "p2=%08x%08x%08x%08x\n", cases[ci].name,
+				    (unsigned long long)vab, pk[0], pk[1], pk[2],
+				    pk[3], pk[4], pk[5], pk[6], pk[7], pk[8],
+				    pk[9], pk[10], pk[11]);
+			} else {
+				printf("SWEETMALI: IDXV %s vab=%llx outside "
+				    "heap %llx+%llx\n", cases[ci].name,
+				    (unsigned long long)vab,
+				    (unsigned long long)sm.heap_pa,
+				    (unsigned long long)sm.heap_size);
+			}
+		}
+
+		/*
+		 * Whether the position shader actually ran is only observable
+		 * through the packet it stores, and the hardware writes that
+		 * pointer back only when it bins something.  Hunt the whole
+		 * zeroed tiler heap for the position values the shader would
+		 * store: the panel triangle (135/2131.5/945/304.5), or the
+		 * transformed origin (540/1218/32768) that an attribute fetch
+		 * returning zeros produces, or NaN.
+		 */
+		{
+			volatile uint32_t *hp = (volatile uint32_t *)sm.heap;
+			uint32_t n = (uint32_t)(zero / 4u);
+			uint32_t hits = 0u;
+
+			for (i = 0; i < n; i++) {
+				uint32_t w = hp[i];
+
+				if (w == 0x43070000u || w == 0x45053800u ||
+				    w == 0x446c4000u || w == 0x43984000u ||
+				    w == 0x44070000u || w == 0x44984000u ||
+				    w == 0x47000000u || w == 0x7fc00000u) {
+					if (hits < 12u) {
+						printf("SWEETMALI: IDXH %s off=%x "
+						    "w=%08x\n", cases[ci].name,
+						    i * 4u, w);
+					}
+					hits++;
+				}
+			}
+			printf("SWEETMALI: IDXH %s hits=%u\n", cases[ci].name,
+			    hits);
+		}
+
+		pxc = sm_fb_read_pixel(fb_base, fb_stride, 1000u, 540u);
+		pxa = sm_fb_read_pixel(fb_base, fb_stride, 1900u, 540u);
+		pxk = sm_fb_read_pixel(fb_base, fb_stride, 2300u, 60u);
+
+		printf("SWEETMALI: IDX %s t=%u w=%u fl=%u pre=%x cf=%x v=%x js=%x "
+		    "f=%x mmu=%x px=%x/%x/%x\n", cases[ci].name, cases[ci].type,
+		    cases[ci].where, cases[ci].flags, pre, cfst, vst, vjs, fjs,
+		    mmu, pxc, pxa, pxk);
+		/*
+		 * Job-header exception record: word 0 low byte = JS_STATUS
+		 * code, bits 8-9 = access type, words 2-3 = fault pointer,
+		 * word 1 = first incomplete task.
+		 */
+		exv = *(volatile uint32_t *)vjob;
+		if ((vst & (1u << (16u + 1u))) || (exv != 0u)) {
+			printf("SWEETMALI: IDXE %s ex=%x fic=%x fp=%x:%x "
+			    "prim=%x ic=%u al=%x ia=%x:%x\n", cases[ci].name,
+			    exv, vjob[1], vjob[3], vjob[2], vjob[8], vjob[11],
+			    vjob[13], vjob[31], vjob[30]);
+		}
+		/*
+		 * The per-AS fault registers are only populated for real MMU
+		 * faults, which the job's own exception code does not cover.
+		 * Print them for every VA case as well, so a translated fetch
+		 * that fails can be told apart from one that was never walked.
+		 * Both address spaces are printed with the AS the case ran in,
+		 * so a fault is *attributed*: AS1's registers must stay clear
+		 * for an AS0 case and vice versa.
+		 */
+		if (mmu || cases[ci].va) {
+			printf("SWEETMALI: IDX FAULT %s as=%u raw=%x "
+			    "a0=%x/%x:%x a1=%x/%x:%x\n", cases[ci].name, asf,
+			    mmu, sm_rd(sm.gpu + SM_AS_FAULTSTATUS(0)),
+			    sm_rd(sm.gpu + SM_AS_FAULTADDRESS_HI(0)),
+			    sm_rd(sm.gpu + SM_AS_FAULTADDRESS_LO(0)),
+			    sm_rd(sm.gpu + SM_AS_FAULTSTATUS(1)),
+			    sm_rd(sm.gpu + SM_AS_FAULTADDRESS_HI(1)),
+			    sm_rd(sm.gpu + SM_AS_FAULTADDRESS_LO(1)));
+		}
+
+		/*
+		 * The fragment shader paints every covered pixel non-black
+		 * (ARGB32) while the rest of the tile range stays the opaque
+		 * black clear, so "drew" means both inside probes are painted
+		 * and the outside probe is still clear.  A faulted job never
+		 * counts as a draw, and neither does a pixel the case never
+		 * touched: it still holds the poison, which is not black either
+		 * (that is how probe 11's rt-shift was misread as a draw).
+		 *
+		 * C1: when the shader is the thing under test the probes are a
+		 * pattern instead.  The colour the new fragment shader produces
+		 * is not written into this driver: the first case that runs it
+		 * records it, and the cases after it must agree with that and
+		 * differ from the panel colour, so the test is "a different
+		 * shader ran" rather than "this driver's byte order is what I
+		 * remembered".
+		 */
+		switch (cases[ci].pxmode) {
+		case SM_PX_NEW:
+			draw = ((vjs == 0) && (mmu == 0) && (pxc == pxa) &&
+			    (pxc != SM_PX_PANEL) && (pxc != SM_PX_CLEAR) &&
+			    (pxc != SM_PX_POISON) &&
+			    (!px_new || (pxc == px_new)) &&
+			    (pxk == SM_PX_CLEAR)) ? TRUE : FALSE;
+			if (draw) {
+				px_new = pxc;
+			}
+			break;
+		case SM_PX_OFF:
+			draw = ((vjs == 0) && (mmu == 0) &&
+			    (pxc == SM_PX_CLEAR) && (pxa == SM_PX_CLEAR) &&
+			    (pxk != SM_PX_CLEAR) && (pxk != SM_PX_PANEL) &&
+			    (pxk != SM_PX_POISON) &&
+			    (!px_new || (pxk == px_new))) ? TRUE : FALSE;
+			break;
+		default:
+			draw = ((vjs == 0) && (mmu == 0) &&
+			    (pxc != SM_PX_CLEAR) && (pxc != SM_PX_POISON) &&
+			    (pxa != SM_PX_CLEAR) && (pxa != SM_PX_POISON) &&
+			    (pxk == SM_PX_CLEAR)) ? TRUE : FALSE;
+			break;
+		}
+		printf("SWEETMALI: IDX %s %s\n", cases[ci].name,
+		    draw ? (cases[ci].pxmode == SM_PX_NEW ? "NEW-COLOUR" :
+		    (cases[ci].pxmode == SM_PX_OFF ? "OFF-PATTERN" : "DREW")) :
+		    "EMPTY");
+		if (px_new) {
+			printf("SWEETMALI: IDX %s new-colour=%08x\n",
+			    cases[ci].name, px_new);
+		}
+		if (cases[ci].expect < 0) {
+			printf("SWEETMALI: IDX %s INFO only\n", cases[ci].name);
+			continue;
+		}
+		ntests++;
+		/*
+		 * "Empty" covers two very different hardware outcomes, and
+		 * the cases that unmap or step past a 4 KiB page have to tell
+		 * them apart: a fetch the MMU refused (the fault *is* the
+		 * proof that the entry went away) and a fetch that found
+		 * mapped bytes the decoder would not take (no fault, so the
+		 * mapping is live and only its contents are wrong).  The case
+		 * says which outcome it is testing, so a must-fault case that
+		 * quietly finds a translation fails instead of passing as a
+		 * plain empty.
+		 */
+		mmu_want = -1;
+		if (cases[ci].va & (SM_VA_NEIGH | SM_VA_4K_UNMAP |
+		    SM_VA_UNMAPPED)) {
+			mmu_want = 1;
+		} else if ((cases[ci].va & SM_VA_4K_ZERO) ||
+		    ((cases[ci].va & SM_VA_AS1) && cases[ci].expect == 0)) {
+			mmu_want = 0;
+		}
+		if (draw == (cases[ci].expect != 0) &&
+		    (mmu_want < 0 || (mmu != 0u) == (mmu_want != 0))) {
+			nok++;
+		} else if (draw != (cases[ci].expect != 0)) {
+			printf("SWEETMALI: IDX %s UNEXPECTED %s\n",
+			    cases[ci].name, draw ? "draw" : "empty");
+		} else {
+			printf("SWEETMALI: IDX %s UNEXPECTED fault state "
+			    "(mmu=%x want=%d)\n", cases[ci].name, mmu,
+			    mmu_want);
+		}
+	}
+
+	if (nok == ntests) {
+		printf("SWEETMALI: INDEX PASS (%u/%u cases, the index buffer "
+		    "drives the triangle)\n", nok, ntests);
+		return 0;
+	}
+	printf("SWEETMALI: INDEX FAIL (%u/%u cases)\n", nok, ntests);
+	return -1;
+}
+
+static boolean_t
+sm_map(void)
+{
+	sm.gpu = ml_io_map(SM_GPU_PA, SM_GPU_SIZE);
+	sm.mfg = ml_io_map(SM_MFG_PA, SM_MMIO_SIZE);
+	sm.scpsys = ml_io_map(SM_SCPSYS_PA, SM_MMIO_SIZE);
+	sm.infra = ml_io_map(SM_INFRA_PA, SM_MMIO_SIZE);
+	sm.top = ml_io_map(SM_TOP_PA, SM_MMIO_SIZE);
+	sm.apmixed = ml_io_map(SM_APMIXED_PA, SM_MMIO_SIZE);
+
+	if (!sm.gpu || !sm.mfg || !sm.scpsys || !sm.infra || !sm.top ||
+	    !sm.apmixed) {
+		printf("SWEETMALI: MMIO mapping failed gpu=%lx mfg=%lx sleep=%lx "
+		    "infra=%lx top=%lx apmixed=%lx\n",
+		    sm.gpu, sm.mfg, sm.scpsys, sm.infra, sm.top, sm.apmixed);
+		return FALSE;
+	}
+	printf("SWEETMALI: MMIO gpu=%lx mfg=%lx sleep=%lx infra=%lx top=%lx "
+	    "apmixed=%lx\n", sm.gpu, sm.mfg, sm.scpsys, sm.infra, sm.top,
+	    sm.apmixed);
+	return TRUE;
+}
+
+static void
+sweet_mali_thread(void *arg, wait_result_t result)
+{
+	unsigned delay_s = 0;
+	int rc;
+
+	(void)arg;
+	(void)result;
+
+	(void)PE_parse_boot_argn("sweetmalidelay", &delay_s, sizeof(delay_s));
+	if (delay_s > 60u) {
+		delay_s = 60u;
+	}
+	if (delay_s) {
+		printf("SWEETMALI: starting in %u s\n", delay_s);
+		/* delay() takes microseconds, so seconds * 1e6. */
+		delay(delay_s * 1000000u);
+	}
+
+	printf("SWEETMALI: bring-up start\n");
+	if (!sm_map()) {
+		goto out;
+	}
+
+	rc = sm_power_and_clock();
+	if (rc) {
+		printf("SWEETMALI: power/clock failed rc=%d\n", -rc);
+		goto out;
+	}
+
+	sm_disable_acp();
+
+	rc = sm_soft_reset();
+	if (rc) {
+		printf("SWEETMALI: reset failed rc=%d\n", -rc);
+		goto out;
+	}
+
+	sm_read_features();
+	sm_apply_g57_quirks();
+
+	rc = sm_power_units_on();
+	if (rc) {
+		printf("SWEETMALI: internal power failed rc=%d\n", -rc);
+		goto out;
+	}
+
+	sm.ready = TRUE;
+	printf("SWEETMALI: Mali-G57 ready (model %x rev %x)\n",
+	    sm.gpu_id, sm.revision);
+
+	rc = sm_mmu_init();
+	if (rc) {
+		printf("SWEETMALI: MMU init failed rc=%d\n", -rc);
+		goto out;
+	}
+	rc = sm_write_value_test();
+	if (rc) {
+		printf("SWEETMALI: write-value test failed rc=%d\n", -rc);
+		goto out;
+	}
+	printf("SWEETMALI: MMU + write-value PASS\n");
+
+	rc = sm_triangle_demo();
+	if (rc) {
+		printf("SWEETMALI: panel triangle failed rc=%d\n", -rc);
+		goto out;
+	}
+
+out:
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+sweet_mali_init(void)
+{
+	int enabled = 1;
+	thread_t thread;
+	kern_return_t kr;
+
+	if (sm.started) {
+		return;
+	}
+	sm.started = TRUE;
+
+	(void)PE_parse_boot_argn("sweetmali", &enabled, sizeof(enabled));
+	if (!enabled) {
+		printf("SWEETMALI: disabled (sweetmali=0)\n");
+		return;
+	}
+
+	kr = kernel_thread_start(sweet_mali_thread, NULL, &thread);
+	if (kr == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("SWEETMALI: kernel_thread_start failed %d\n", kr);
+	}
+}
