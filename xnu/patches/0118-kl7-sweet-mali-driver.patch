+		}
+
+		if (cases[ci].va) {
+			/*
+			 * Point this batch at the custom VA window.  Every
+			 * group is independent so a case can name exactly
+			 * one pointer class.
+			 */
+			uint32_t *p_vspd = (uint32_t *)(base + SM_TRI_VSPD);
+			uint32_t *p_fspd = (uint32_t *)(base + SM_TRI_FSPD);
+			uint32_t *p_res = (uint32_t *)(base + SM_TRI_RES);
+			uint32_t *p_heap = (uint32_t *)(base + SM_TRI_HEAP);
+			uint32_t *p_tctx = (uint32_t *)(base + SM_TRI_TCTX);
+			uint32_t *p_fbd = (uint32_t *)(base + SM_TRI_FBD);
+			uint32_t *p_rt = (uint32_t *)(base + SM_TRI_RT);
+			const uint64_t va_rtab = va_res | 8u;
+
+			if (cases[ci].va & SM_VA_CODE) {
