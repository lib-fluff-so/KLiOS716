+/*
+ * ---------------------------------------------------------------------------
+ * C1: the shader program descriptor, built from metadata
+ * ---------------------------------------------------------------------------
+ *
+ * Up to probe 16 every descriptor was four literals written next to the blob
+ * it described, so a blob and its descriptor could disagree without anything
+ * noticing -- and the compiler knows facts about a blob (how many registers
+ * it uses, which registers it preloads) that the hardware is told separately.
+ *
+ * This is the whole of what panfrost's pan_shader_info contributes to a
+ * Valhall Shader Program Descriptor, plus the stage the driver is compiling
+ * for.  It is what a user client would hand the kernel in stage D.
+ */
+struct sm_shader {
+	const uint32_t *code;
+	uint32_t words;
+	uint32_t work_reg_count;	/* pan_shader_info.work_reg_count */
+	uint64_t preload;		/* pan_shader_info.preload */
+	uint32_t stage;
+};
+
+#define SM_STAGE_VERTEX   0u
+#define SM_STAGE_FRAGMENT 1u
+
+/*
+ * Pack the 16-byte Valhall Shader Program Descriptor.  Field positions and
+ * enum values are Mesa's genxml/v9.xml <struct name="Shader Program">:
+ *
+ *   word0 [3:0]   descriptor type, 8 = Shader
+ *         [7:4]   stage, 2 = fragment, 3 = vertex
+ *         [8]     fragment coverage bitmask type, 1 = GL    (fragment)
+ *         [9:8]   vertex warp limit, 1 = half               (vertex)
+ *         [31:30] register allocation, 2 = 32/thread, 0 = 64/thread
+ *   word1 [15:0]  preload bitmap, bit (reg - 48) for registers r48..r63
+ *   word2..3      address of the code
+ *
+ * Both descriptors the driver used before this patch come out of it exactly:
+ * vertex 0x80000138/0x00001800 and fragment 0x80000128/0x00003000, which is
+ * why the whole of the probe-16 test set is also this packer's regression
+ * test.
+ */
+static void
+sm_shader_pack(uint32_t *spd, const struct sm_shader *sh, uint64_t code_a)
+{
+	uint32_t w0 = 8u;	/* Descriptor Type: Shader */
+
+	if (sh->stage == SM_STAGE_VERTEX) {
+		w0 |= 3u << 4;			/* Stage: Vertex */
+		w0 |= 1u << 8;			/* Vertex warp limit: half */
+	} else {
+		w0 |= 2u << 4;			/* Stage: Fragment */
+		w0 |= 1u << 8;			/* Coverage bitmask type: GL */
+	}
+	/* pan_register_allocation(): 32 registers per thread above 32. */
+	w0 |= (sh->work_reg_count <= 32u ? 2u : 0u) << 30;
+
+	spd[0] = w0;
+	/*
+	 * pan_shader_info.preload is a register mask; the descriptor carries
+	 * r48..r63 one bit each, so the mask's bits 48..63 are word1 bits
+	 * 0..15 verbatim -- the same shift Mesa's own packer uses
+	 * (panvk_vX_shader.c: spd.preload.r48_r63 = info->preload >> 48).
+	 * For these shaders that is 0x1800 (vertex), 0x3000 (fragment) and
+	 * 0x3800 (attribute vertex), the values the descriptors have carried
+	 * since probe 9.
+	 */
+	spd[1] = (uint32_t)(sh->preload >> 48);
+	spd[2] = (uint32_t)code_a;
+	spd[3] = (uint32_t)(code_a >> 32);
+}
+
+/* What pan_shad reported for each blob: work_reg_count, preload, stage. */
+static const struct sm_shader sm_sh_panel_vs = { sm_panel_vs_code, 64u,
+	32u, 0x18ull << 56, SM_STAGE_VERTEX };
+static const struct sm_shader sm_sh_panel_fs = { sm_panel_fs_code, 32u,
+	32u, 0x30ull << 56, SM_STAGE_FRAGMENT };
+static const struct sm_shader sm_sh_attr_vs = { sm_vs_attr_code, 64u,
+	32u, 0x38ull << 56, SM_STAGE_VERTEX };
+static const struct sm_shader sm_sh_fs_blue = { sm_fs_blue_code, 32u,
+	32u, 0x30ull << 56, SM_STAGE_FRAGMENT };
+static const struct sm_shader sm_sh_vs_off = { sm_vs_off_code, 64u,
+	32u, 0x18ull << 56, SM_STAGE_VERTEX };
+
+/* Copy a blob into one of the page's code slots. */
+static void
+sm_shader_copy(uint32_t *dst, const struct sm_shader *sh)
+{
+	uint32_t i;
+
+	for (i = 0; i < sh->words; i++) {
+		dst[i] = sh->code[i];
+	}
+}
