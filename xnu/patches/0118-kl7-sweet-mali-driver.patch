+#define SM_GPU_L2_READY_LO       0x160u
+#define SM_GPU_SHADER_PWRON_LO   0x180u
+#define SM_GPU_TILER_PWRON_LO    0x190u
+#define SM_GPU_L2_PWRON_LO       0x1a0u
+#define SM_GPU_JM_CONFIG         0xf00u
+#define SM_GPU_SHADER_CONFIG     0xf04u
+
+#define SM_GPU_IRQ_RESET_COMPLETED (1u << 8)
+#define SM_GPU_CMD_SOFT_RESET      0x01u
+#define SM_GPU_CMD_HARD_RESET      0x02u
+#define SM_SC_VAR_ALGORITHM        (1u << 29)
+#define SM_JM_DEFAULT_IDVS_GROUP   (0xfu << 16)
+
+/* GPU MMU (AS0), from the shim's gpu.c. */
+#define SM_MMU_INT_RAWSTAT   0x2000u
+#define SM_MMU_INT_CLEAR     0x2004u
+#define SM_MMU_INT_MASK      0x2008u
+#define SM_MMU_BASE          0x2400u
+#define SM_MMU_AS_SHIFT      6u
+#define SM_MMU_AS(as)        (SM_MMU_BASE + ((as) << SM_MMU_AS_SHIFT))
+#define SM_AS_TRANSTAB_LO(as)     (SM_MMU_AS(as) + 0x00u)
+#define SM_AS_TRANSTAB_HI(as)     (SM_MMU_AS(as) + 0x04u)
+#define SM_AS_MEMATTR_LO(as)      (SM_MMU_AS(as) + 0x08u)
+#define SM_AS_MEMATTR_HI(as)      (SM_MMU_AS(as) + 0x0cu)
+#define SM_AS_LOCKADDR_LO(as)     (SM_MMU_AS(as) + 0x10u)
+#define SM_AS_LOCKADDR_HI(as)     (SM_MMU_AS(as) + 0x14u)
+#define SM_AS_COMMAND(as)         (SM_MMU_AS(as) + 0x18u)
+#define SM_AS_FAULTSTATUS(as)     (SM_MMU_AS(as) + 0x1cu)
+#define SM_AS_FAULTADDRESS_LO(as) (SM_MMU_AS(as) + 0x20u)
+#define SM_AS_FAULTADDRESS_HI(as) (SM_MMU_AS(as) + 0x24u)
+#define SM_AS_STATUS(as)          (SM_MMU_AS(as) + 0x28u)
+
+#define SM_AS_COMMAND_UPDATE      0x01u
+#define SM_AS_COMMAND_LOCK        0x02u
+#define SM_AS_COMMAND_UNLOCK      0x03u
+#define SM_AS_COMMAND_FLUSH_PT    0x04u
+#define SM_AS_COMMAND_FLUSH_MEM   0x05u
+#define SM_AS_STATUS_AS_ACTIVE    0x01u
+#define SM_AS_TRANSTAB_MODE_TABLE 0x03u
+#define SM_AS_TRANSTAB_READ_INNER 0x04u
+#define SM_MALI_MEMATTR           0x888d88u
+
+/*
+ * Panfrost's lock_region(): the region a command applies to is a naturally
+ * aligned power of two, encoded in AS_LOCKADDR as log2(size) - 1, and it may
+ * never be smaller than AS_LOCK_REGION_MIN_SIZE (32 KiB).
+ */
+#define SM_AS_LOCK_MIN_LOG2       15u
+
+/*
+ * Mali's own LPAE dialect, the one panfrost uses on this GPU
+ * (drivers/iommu/io-pgtable-arm-common.c, ARM_MALI_LPAE): the type field is
+ * 0b01 for *every* leaf -- a 2 MiB block and a 4 KiB page alike, at any
+ * level -- and 0b11 only for a pointer to the next table.  Plain ARM LPAE
+ * would write 0b11 on a level-3 page descriptor instead; Mali then reads
+ * that bottom-level entry as a table pointer, walks to a table that does not
+ * exist and faults.  That was the whole probe-12 failure.
+ */
+#define SM_LPAE_TABLE_DESC  0x003u	/* pointer to the next table */
+#define SM_LPAE_LEAF_DESC   0x001u	/* block *or* page, any level */
+#define SM_LPAE_SH_OS       0x200u
+#define SM_LPAE_HAP_READ    0x040u
+#define SM_LPAE_HAP_WRITE   0x080u
+#define SM_MALI_BLOCK_2M    0x200000ull
+#define SM_GPU_PAGE_SIZE    0x1000u
+
+/* Job scheduler, from the shim's gpu.c. */
+#define SM_JOB_INT_RAWSTAT   0x1000u
+#define SM_JOB_INT_CLEAR     0x1004u
+#define SM_JOB_INT_MASK      0x1008u
+#define SM_JS_BASE           0x1800u
+#define SM_JS_SLOT_STRIDE    0x80u
+#define SM_JS_STATUS(js)           (SM_JS_BASE + (js) * SM_JS_SLOT_STRIDE + 0x24u)
+#define SM_JS_HEAD_NEXT_LO(js)     (SM_JS_BASE + (js) * SM_JS_SLOT_STRIDE + 0x40u)
+#define SM_JS_HEAD_NEXT_HI(js)     (SM_JS_BASE + (js) * SM_JS_SLOT_STRIDE + 0x44u)
+#define SM_JS_AFFINITY_NEXT_LO(js) (SM_JS_BASE + (js) * SM_JS_SLOT_STRIDE + 0x50u)
+#define SM_JS_AFFINITY_NEXT_HI(js) (SM_JS_BASE + (js) * SM_JS_SLOT_STRIDE + 0x54u)
+#define SM_JS_CONFIG_NEXT(js)      (SM_JS_BASE + (js) * SM_JS_SLOT_STRIDE + 0x58u)
+#define SM_JS_COMMAND_NEXT(js)     (SM_JS_BASE + (js) * SM_JS_SLOT_STRIDE + 0x60u)
+#define SM_JS_COMMAND(js)          (SM_JS_BASE + (js) * SM_JS_SLOT_STRIDE + 0x20u)
+#define SM_JS_HEAD_LO(js)          (SM_JS_BASE + (js) * SM_JS_SLOT_STRIDE + 0x00u)
+#define SM_JS_HEAD_HI(js)          (SM_JS_BASE + (js) * SM_JS_SLOT_STRIDE + 0x04u)
+#define SM_JS_TAIL_LO(js)          (SM_JS_BASE + (js) * SM_JS_SLOT_STRIDE + 0x08u)
+#define SM_JS_TAIL_HI(js)          (SM_JS_BASE + (js) * SM_JS_SLOT_STRIDE + 0x0cu)
+#define SM_JS_COMMAND_START   0x01u
+#define SM_JS_COMMAND_HARD_STOP 0x03u
+#define SM_JS_CONFIG_START_MMU (1u << 10)
+#define SM_JS_CONFIG_PRI_8    (8u << 16)
+#define SM_JS_CONFIG_FLUSH_BOTH 0x00003300u
+#define SM_JS_CONFIG_BASE     (SM_JS_CONFIG_PRI_8 | SM_JS_CONFIG_FLUSH_BOTH)
+#define SM_JOB_TYPE_WRITE_VALUE 2u
+#define SM_WRITE_VALUE_IMM64    7u
+
+/* Real panel framebuffer, same physical memory the XNU fbcon uses. */
+#define SM_PANEL_FB_PA     0xFDFFF000ull
+#define SM_PANEL_W         1080u
+#define SM_PANEL_H         2436u
+#define SM_PANEL_STRIDE    4352u
+#define SM_PANEL_BYTES     (SM_PANEL_STRIDE * 2436ull)
+#define SM_TILER_HEAP_SIZE 0x02000000ull
+#define SM_TILER_HEAP_ZERO 0x00400000ull
+#define SM_TRI_DS_OFF      0x0fc0u
+
+/* The shim's compact triangle descriptor layout inside one 4 KiB block. */
+enum {
+	SM_TRI_FRAG   = 0x000,
+	SM_TRI_FBD    = 0x100,
+	SM_TRI_RT     = 0x180,
+	SM_TRI_HEAP   = 0x200,
+	SM_TRI_TCTX   = 0x240,
+	SM_TRI_VSPD   = 0x300,
+	SM_TRI_FSPD   = 0x320,
+	SM_TRI_BLND   = 0x340,
+	SM_TRI_VSCODE = 0x400,
+	SM_TRI_FSCODE = 0x500,
+	SM_TRI_VJOB   = 0x800,
+	SM_TRI_CFLUSH = 0xc00,
+	SM_TRI_INDICES = 0xd00,
+	SM_TRI_RES    = 0x040,
+	SM_TRI_ATTR   = 0x600,	/* ATTRIBUTE descriptor (32 B) */
+	SM_TRI_ATTRBUF = 0x680,	/* BUFFER descriptor table (3 x 32 B) */
+	SM_TRI_VBUF   = 0x700,	/* vertex data, 3 x 16 B per block */
+	SM_TRI_VBLK   = 0x40,	/* spacing between vertex blocks */
+};
+
+#define SM_TIMEOUT_STEPS 100000u
+#define SM_TIMEOUT_US    10u
+
+/*
+ * Mali pixel format for one per-vertex R32G32B32A32_FLOAT attribute:
+ * MALI_PACK_FMT(RGBA32F, RGBA, L) == (191 << 12) | swizzle(0) | srgb(0).
+ * Mesa never stores the bare format index in a descriptor: "Format" fields
+ * (ATTRIBUTE, VARYING, render target conversion, ...) are 22-bit pixel
+ * formats whose index lives at bit 12 (see MALI_EXTRACT_INDEX and
+ * pan_special_format's "format << 12").
+ */
+#define SM_ATTR_PIXFMT   (191u << 12)	/* RGBA32F, swizzle RGBA */
+
+/* Format variants selectable per case through vbi bits 12..15. */
+#define SM_FMT_RGBA32F   0u	/* 191 << 12, the correct encoding */
+#define SM_FMT_SNAP4     1u	/* 94 << 12: RGBA32F + snap 2^-8 */
+#define SM_FMT_BARE      2u	/* 191: bare index (the old encoding) */
+#define SM_FMT_ZERO      3u	/* 0: unassigned format entry */
+
+/*
+ * Custom (non-identity) GPU virtual address window.  The Mali page tables
+ * are three levels of 512 entries: PGD covers VA 47:39, PUD 38:30 and PMD
+ * 29:21, where a PMD entry may be a 2 MiB block.  Everything the pipeline
+ * touches (descriptor page, tiler heap, panel framebuffer) is mapped a
+ * second time inside this window, so a case can hand the hardware an
+ * address that is *not* the physical address and prove the fetch really
+ * goes through the page table walk -- the prerequisite for BOs at
+ * arbitrary GPU VAs and for per-client isolation.
+ *
+ * SM_VA_BASE is 2^38: inside the first PGD entry's 512 GiB and far above
+ * every physical address this phone maps (all < 8 GiB), so a translated
+ * pointer can never accidentally hit an identity mapping.
+ */
+#define SM_VA_BASE    0x4000000000ull		/* 2^38, 2 MiB aligned */
+#define SM_VA_PUD_INDEX 256u	/* (SM_VA_BASE >> 30) & 0x1ff */
+#define SM_VA_PMD_PAGE  3u	/* tables page holding the window's PMDs */
+#define SM_VA_PTE_PAGE  4u	/* tables page holding the 4 KiB PTEs */
+#define SM_TABLES_PAGES 5u	/* PGD, PUD, identity PMD, window PMD, PTE */
+#define SM_VAW_TRI    (SM_VA_BASE + 0x00000000ull)
+#define SM_VAW_HEAP   (SM_VA_BASE + 0x04000000ull)	/* +64 MiB */
+#define SM_VAW_FB     (SM_VA_BASE + 0x20000000ull)	/* +512 MiB */
+/*
+ * 4 KiB window: PMD index 128 (+256 MiB) is unused by the block windows, so
+ * that entry can be a *table* pointer to page 4 and the tri page then lives
+ * there one 4 KiB page at a time -- with every neighbouring page unmapped,
+ * which is what makes the granularity observable.
+ */
+#define SM_VAW4K      (SM_VA_BASE + 0x10000000ull)	/* +256 MiB */
+#define SM_VA_PMD4K_INDEX 128u	/* (SM_VAW4K >> 21) & 0x1ff */
+
+/*
+ * Stage A3/B1: a real GPU VA allocator and a BO allocator.
+ *
+ * A3 -- the area is a 256 MiB slice of the same PGD entry the window uses,
+ * reached through its own PUD entry (258), so nothing it does can disturb
+ * the identity maps, the window or the 4 KiB window.  A 4 KiB-granular
+ * bitmap hands out first-fit contiguous ranges, and the *table* pages (one
+ * PMD page for the area, one PTE page per 2 MiB PMD entry) are taken from a
+ * pool on first touch and zeroed then -- nothing is preallocated, which is
+ * the difference between this and sm_pt_build()'s fixed windows.
+ *
+ * B1 -- a BO is one contiguous physical allocation handed out as a small
+ * handle (an index into a table) and mapped at a VA the allocator chose:
+ * create -> map -> fill -> submit -> unmap -> destroy, the whole lifecycle a
+ * GEM object needs.
+ */
+#define SM_VA_AREA_BASE   (SM_VA_BASE + 0x80000000ull)	/* +2 GiB */
+#define SM_VA_AREA_PUD_INDEX 258u	/* (SM_VA_AREA_BASE >> 30) & 0x1ff */
+#define SM_VA_AREA_SIZE   (256ull << 20)
+#define SM_VA_AREA_PAGES  ((uint32_t)(SM_VA_AREA_SIZE / SM_GPU_PAGE_SIZE))
+#define SM_VA_BITMAP_WORDS ((SM_VA_AREA_PAGES + 31u) / 32u)
+#define SM_VA_GUARD_OFF   0x400000ull	/* area + 4 MiB: never allocated */
+#define SM_TABLE_POOL_PAGES 16u	/* PMD/PTE pages for the area */
+#define SM_TABLES_TOTAL_PAGES (SM_TABLES_PAGES + SM_TABLE_POOL_PAGES)
+#define SM_BO_MAX 4u
+
+/* Which pointers of a batch use the custom VA instead of the PA. */
+#define SM_VA_CODE    0x01u	/* shader code (vspd/fspd word 2..3) */
+#define SM_VA_DESC    0x02u	/* job descriptor pointers, tctx, fbd, tls */
+#define SM_VA_TBL     0x04u	/* resource table entries (attr/buf tables) */
+#define SM_VA_VTX     0x08u	/* vertex buffer descriptor address */
+#define SM_VA_HEAP    0x10u	/* tiler heap data pointers (heap words 2..7) */
+#define SM_VA_FB      0x20u	/* render target base address */
+#define SM_VA_ALL     0x3fu
+/*
+ * Probe 11's "rt-shift" (render target 8 MiB inside the panel) proved that
+ * rt[8]/[9] really is the writeback address -- the writeback ran off the end
+ * of the mapped panel and latched a real MMU fault at 0xfec00500 (status
+ * a003c2).  It also wedged fragment JS0 for the rest of the boot and left
+ * stripes in panel memory the OS never repaints, so the case is gone; the
+ * evidence is in the log and in section 17 of HANDOFF.md.
+ *
+ * 4 KiB pages (stage A2): the same tri page is mapped page-granular so the
+ * mapping itself can be told apart from a 2 MiB block.
+ */
+#define SM_VA_4K      0x80u	/* tri page through the 4 KiB mapping */
+#define SM_VA_NEIGH   0x100u	/* negative control: shader code one 4 KiB page further */
+/*
+ * The mapping itself, not a pointer that uses it: the free/reuse cycle a BO
+ * needs.  Each is the 4 KiB case plus one edit of the PTE, made just before
+ * the batch runs.
+ */
+#define SM_VA_4K_UNMAP 0x200u	/* clear the PTE, then FLUSH_PT */
+#define SM_VA_4K_ZERO  0x400u	/* PTE -> a page of zeros (mapped, not code) */
+#define SM_VA_4K_CODE  0x800u	/* PTE -> the code page again */
+/*
+ * A4: run the batch in the second address space.  kbase's
+ * kbase_job_hw_submit() puts the AS number in JS_CONFIG (`cfg = (u32)
+ * kctx->as_nr;`), so "which AS" is four bits of the job-slot config and
+ * nothing else; the pointers of the batch do not change at all.
+ */
+#define SM_VA_AS1     0x1000u
+/*
+ * A3/B1: the batch's page-internal pointers use a VA the *allocator* handed
+ * out (the BO's own mapping) instead of the fixed window, and the guard
+ * cases name a VA inside the area that was never allocated -- so the fetch
+ * must be refused.  Which BO the case names is itself the variable, because
+ * two different BOs have two different VAs, and "the same VA again" after a
+ * free is how first-fit reuse is observed.
+ */
+#define SM_VA_BO0     0x2000u
+#define SM_VA_BO1     0x4000u
+#define SM_VA_BO2     0x8000u
+#define SM_VA_GUARD   0x10000u
+#define SM_VA_UNMAPPED 0x20000u	/* the MMU must refuse this fetch */
+
+/* BO lifecycle actions, run before the batch (see sm_case_action()). */
+#define SM_ACT_NONE     0u
+#define SM_ACT_BO0      1u	/* open BO0 (create + map) */
+#define SM_ACT_BO1      2u	/* open BO1, a 2 MiB BO */
+#define SM_ACT_BO0_FREE 3u	/* unmap + destroy BO0 */
+#define SM_ACT_BO2      4u	/* open BO2 after BO0 was freed */
+#define SM_ACT_BO_FIN   5u	/* tear what is left down */
+
+/*
+ * C1: which shader pair a case packs its descriptors from.  NONE means the
+ * boot-built panel pair, so every case before this patch behaves as it did.
+ */
+#define SM_SH_NONE        0u	/* the boot-built panel VS + panel FS */
+#define SM_SH_FS_BLUE     1u	/* panel VS + the new fragment shader */
+#define SM_SH_VS_OFF      2u	/* the new moved VS + the new FS */
+#define SM_SH_FS_BADSTAGE 3u	/* the new FS labelled as a vertex shader */
+
+/*
+ * C1: what the three pixel probes must show when the shader is the thing
+ * under test.  0 is the original "painted inside, black outside" test.
+ * The new fragment shader's colour is not written down anywhere: the case
+ * that runs it records what it produced and the cases after it only have to
+ * agree with that, plus differ from the panel colour the whole suite has
+ * been reading back since probe 9 (0xff00ff00).  That keeps the test about
+ * "a different shader ran" instead of about this driver's byte order.
+ */
+#define SM_PX_OLD   0u	/* the original test */
+#define SM_PX_NEW   1u	/* both inside probes = the new colour, outside clear */
+#define SM_PX_OFF   2u	/* inside probes clear, outside probe = the new colour */
+
+#define SM_PX_PANEL 0xff00ff00u	/* what the panel FS paints */
+#define SM_PX_CLEAR 0xff000000u	/* the job's opaque black clear */
+#define SM_PX_POISON 0xdeadbeefu	/* written by the harness, never by a job */
+
+/*
+ * B1: one BO.  The handle handed out is the index into sm.bo[], the same
+ * shape a GEM handle table has; `gpu_va` is 0 while the BO is not mapped.
+ */
+struct sm_bo {
+	vm_offset_t kva;
+	uint64_t pa;
+	uint64_t size;
+	uint64_t gpu_va;
+	boolean_t used;
+};
+
+static struct sweet_mali {
+	vm_offset_t gpu;
+	vm_offset_t mfg;
+	vm_offset_t scpsys;
+	vm_offset_t infra;
+	vm_offset_t top;
+	vm_offset_t apmixed;
+
+	uint32_t gpu_id;
+	uint32_t revision;
+	uint32_t l2_present;
+	uint32_t shader_present;
+	uint32_t tiler_present;
+	uint32_t as_present;
+	uint32_t js_present;
+	uint32_t mmu_features;
+	uint32_t mem_features;
+	uint32_t thread_features;
+	uint32_t coherency_features;
+	uint32_t max_threads;
+	uint32_t max_workgroup;
+	uint32_t max_barrier;
+
+	vm_offset_t tables;
+	uint64_t tables_pa;
+	/*
+	 * A second, independent page-table set for AS1 (stage A4): the same
+	 * identity maps and the same VA window, except that the one 4 KiB page
+	 * holds a page of zeros instead of the shader code.
+	 */
+	vm_offset_t as1_tables;
+	uint64_t as1_tables_pa;
+	vm_offset_t job;
+	uint64_t job_pa;
+	vm_offset_t target;
+	uint64_t target_pa;
+
+	/* Panel triangle: descriptor block, tiler heap, CPU view of the panel. */
+	vm_offset_t tri;
+	uint64_t tri_pa;
+	/*
+	 * A page of zeros, mapped through the 4 KiB window: a live PTE whose
+	 * contents are not code, so the fetch is mapped and still does not
+	 * draw -- which is how a mapping change is told apart from a fault.
+	 */
+	vm_offset_t zero;
+	uint64_t zero_pa;
+	vm_offset_t heap;
+	uint64_t heap_pa;
+	uint64_t heap_size;
+	vm_offset_t fb_map;
+
+	/*
+	 * A3: the area's own PMD page (NULL until the first mapping asks for
+	 * it) and the pool page counter -- the pool is the only source of
+	 * table pages for the area, so `pool_used` before/after a mapping is
+	 * the direct evidence that table pages were created lazily.
+	 */
+	uint64_t *area_pmd;
+	uint32_t pool_used;
+	/* A3: 4 KiB-granular allocation bitmap over the VA area. */
+	uint32_t va_used[SM_VA_BITMAP_WORDS];
+	/* B1: BO handle table. */
+	struct sm_bo bo[SM_BO_MAX];
+
+	boolean_t ready;
+	boolean_t started;
+} sm;
+
+/*
+ * The page-table set the mapping helpers write into, as (kVA, PA).  AS0 uses
+ * sm.tables; sm_pt_select(1) points it at the second set, which is how a
+ * second address space gets built and edited with exactly the same code.
+ */
+static uint64_t *sm_pt_tables;
+static uint64_t sm_pt_base;
+
+static void
+sm_pt_select(uint32_t as)
+{
+	if (as == 1u) {
+		sm_pt_tables = (uint64_t *)sm.as1_tables;
+		sm_pt_base = sm.as1_tables_pa;
+	} else {
+		sm_pt_tables = (uint64_t *)sm.tables;
+		sm_pt_base = sm.tables_pa;
+	}
+}
+
+static inline uint32_t
+sm_rd(vm_offset_t addr)
+{
+	uint32_t value = *(volatile uint32_t *)addr;
+	__asm__ volatile("dsb sy" ::: "memory");
+	return value;
+}
+
+static inline void
+sm_wr(vm_offset_t addr, uint32_t value)
+{
+	*(volatile uint32_t *)addr = value;
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+static int
+sm_wait(vm_offset_t addr, uint32_t mask, uint32_t value)
+{
+	for (uint32_t i = 0; i < SM_TIMEOUT_STEPS; i++) {
+		if ((sm_rd(addr) & mask) == value) {
+			return 0;
+		}
+		delay(SM_TIMEOUT_US);
+	}
+	return -1;
+}
+
+static int
+sm_mtcmos_wait(uint32_t mask)
+{
+	for (uint32_t i = 0; i < SM_TIMEOUT_STEPS; i++) {
+		uint32_t s1 = sm_rd(sm.scpsys + SM_PWR_STATUS) & mask;
+		uint32_t s2 = sm_rd(sm.scpsys + SM_PWR_STATUS2) & mask;
+		if (s1 == mask && s2 == mask) {
+			return 0;
+		}
+		delay(SM_TIMEOUT_US);
+	}
+	return -1;
+}
+
+static int
+sm_mtcmos_on(uint32_t con_reg, uint32_t status_mask, const char *name)
+{
+	uint32_t con = sm_rd(sm.scpsys + con_reg);
+
+	sm_wr(sm.scpsys + con_reg, con | SM_PWR_ON);
+	con = sm_rd(sm.scpsys + con_reg);
+	sm_wr(sm.scpsys + con_reg, con | SM_PWR_ON_2ND);
+
+	if (sm_mtcmos_wait(status_mask)) {
+		printf("SWEETMALI: %s power timeout CON=%x STA=%x/%x\n",
+		    name, sm_rd(sm.scpsys + con_reg),
+		    sm_rd(sm.scpsys + SM_PWR_STATUS),
+		    sm_rd(sm.scpsys + SM_PWR_STATUS2));
+		return -1;
+	}
+	delay(100);
+
+	con = sm_rd(sm.scpsys + con_reg);
+	sm_wr(sm.scpsys + con_reg, con & ~SM_PWR_CLK_DIS);
+	con = sm_rd(sm.scpsys + con_reg);
+	sm_wr(sm.scpsys + con_reg, con & ~SM_PWR_ISO);
+	con = sm_rd(sm.scpsys + con_reg);
+	sm_wr(sm.scpsys + con_reg, con | SM_PWR_RST_B);
+	con = sm_rd(sm.scpsys + con_reg);
+	sm_wr(sm.scpsys + con_reg, con & ~SM_SRAM_PDN);
+
+	for (uint32_t i = 0; i < SM_TIMEOUT_STEPS; i++) {
+		if (!(sm_rd(sm.scpsys + con_reg) & SM_SRAM_PDN_ACK)) {
+			break;
+		}
+		delay(SM_TIMEOUT_US);
+	}
+	printf("SWEETMALI: %s on CON=%x STA=%x/%x\n", name,
+	    sm_rd(sm.scpsys + con_reg),
+	    sm_rd(sm.scpsys + SM_PWR_STATUS),
+	    sm_rd(sm.scpsys + SM_PWR_STATUS2));
+	return 0;
+}
+
+static void
+sm_mfg1_clear_protection(void)
+{
+	sm_wr(sm.infra + SM_PROTECTEN_2_CLR, SM_PROT_STEP2_1);
+	sm_wr(sm.infra + SM_PROTECTEN_CLR, SM_PROT_STEP2_0);
+	sm_wr(sm.infra + SM_PROTECTEN_2_CLR, SM_PROT_STEP1_1);
+	sm_wr(sm.infra + SM_PROTECTEN_1_CLR, SM_PROT_STEP1_0);
+	printf("SWEETMALI: mfg1 protection clear STA=%x/%x/%x\n",
+	    sm_rd(sm.infra + SM_PROTECTSTA1),
+	    sm_rd(sm.infra + SM_PROTECTSTA1_1),
+	    sm_rd(sm.infra + SM_PROTECTSTA1_2));
+}
+
+/*
+ * MediaTek routes GPU traffic through the Accelerator Coherency Port by
+ * default.  The route is broken on this SoC and makes every job fault with
+ * DATA_INVALID_FAULT.  Bit 9 of INFRA_MFG_SLAVE_GALS_CTRL disables it; the
+ * downstream MT6789 gpufreq driver and the MT8192 ChromeOS kbase fix agree.
+ */
+static void
+sm_disable_acp(void)
+{
+	uint32_t val = sm_rd(sm.infra + SM_MFG_SLAVE_GALS_CTRL);
+
+	sm_wr(sm.infra + SM_MFG_SLAVE_GALS_CTRL, val | (1u << SM_DIS_MFG2ACP_BIT));
+	printf("SWEETMALI: ACP disabled INFRA_CTL=%x\n",
+	    sm_rd(sm.infra + SM_MFG_SLAVE_GALS_CTRL));
+}
+
+static int
+sm_ref_clock_on(void)
+{
+	/*
+	 * topckgen muxes are changed through the write-1-to-clear /
+	 * write-1-to-set pair, then the update bit; CLK_CFG_4 itself only
+	 * reports the current state.
+	 */
+	sm_wr(sm.top + SM_TOP_CLK_CFG_4_CLR,
+	    (0x3u << SM_TOP_MFG_REF_SHIFT) | SM_TOP_MFG_REF_GATE);
+	sm_wr(sm.top + SM_TOP_CLK_CFG_4_SET, 0u);
+	sm_wr(sm.top + SM_TOP_CLK_CFG_UPDATE, SM_TOP_MFG_UPDATE);
+	delay(20);
+
+	uint32_t cfg = sm_rd(sm.top + SM_TOP_CLK_CFG_4);
+	uint32_t ref = (cfg >> SM_TOP_MFG_REF_SHIFT) & 0x3u;
+
+	printf("SWEETMALI: mfg_ref_sel=%u CFG4=%x\n", ref, cfg);
+	if ((cfg & SM_TOP_MFG_REF_GATE) || (ref != 0u)) {
+		return -1;
+	}
+	return 0;
+}
+
+static int
+sm_pll_on(void)
+{
+	uint32_t con3 = sm_rd(sm.apmixed + SM_MFGPLL_CON3);
+
+	sm_wr(sm.apmixed + SM_MFGPLL_CON3, con3 | 1u);
+	delay(10);
+	con3 = sm_rd(sm.apmixed + SM_MFGPLL_CON3);
+	sm_wr(sm.apmixed + SM_MFGPLL_CON3, con3 & ~2u);
+	delay(10);
+
+	uint32_t con0 = sm_rd(sm.apmixed + SM_MFGPLL_CON0);
+	sm_wr(sm.apmixed + SM_MFGPLL_CON0, con0 | 1u);
+	delay(20);
+
+	uint64_t pcw = (((SM_GPU_CLOCK_KHZ / 100u) *
+	    (1u << SM_GPU_PLL_POSDIV)) << 14) / 26u;
+	pcw = (pcw + 5u) / 10u;
+	sm_wr(sm.apmixed + SM_MFGPLL_CON1,
+	    SM_MFGPLL_PCW_CHG | (SM_GPU_PLL_POSDIV << SM_MFGPLL_POSDIV_S) |
+	    (uint32_t)pcw);
+	delay(50);
+
+	printf("SWEETMALI: mfgpll %u kHz PCW=%x CON0=%x CON1=%x CON3=%x\n",
+	    SM_GPU_CLOCK_KHZ, (uint32_t)pcw,
+	    sm_rd(sm.apmixed + SM_MFGPLL_CON0),
+	    sm_rd(sm.apmixed + SM_MFGPLL_CON1),
+	    sm_rd(sm.apmixed + SM_MFGPLL_CON3));
+	return 0;
+}
+
+static void
+sm_external_gates_on(void)
+{
+	uint32_t val = sm_rd(sm.mfg + 0x20u);
+
+	sm_wr(sm.mfg + 0x20u,
+	    val | (1u << 22) | (1u << 23) | (1u << 24) | (1u << 25));
+
+	val = sm_rd(sm.mfg + 0xb0u);
+	sm_wr(sm.mfg + 0xb0u, val & ~((1u << 10) | (1u << 9)));
+
+	val = sm_rd(sm.mfg + 0xb4u);
+	sm_wr(sm.mfg + 0xb4u, val | (1u << 4));
+
+	val = sm_rd(sm.mfg + 0xb0u);
+	sm_wr(sm.mfg + 0xb0u, (val | (1u << 19)) & ~(1u << 8));
+
+	val = sm_rd(sm.mfg + 0x24u);
+	sm_wr(sm.mfg + 0x24u, val | 1u);
+
+	val = sm_rd(sm.mfg + 0xf60u);
+	sm_wr(sm.mfg + 0xf60u, val | 1u);
+}
+
+static int
+sm_main_clock_on(void)
+{
+	if (sm_pll_on()) {
+		return -1;
+	}
+
+	/* mfg_pll_sel is a width-1 mux at bit 18 with no update bit. */
+	sm_wr(sm.top + SM_TOP_CLK_CFG_4_CLR, SM_TOP_MFG_PLL_SEL);
+	sm_wr(sm.top + SM_TOP_CLK_CFG_4_SET, SM_TOP_MFG_PLL_SEL);
+	delay(10);
+	if (!(sm_rd(sm.top + SM_TOP_CLK_CFG_4) & SM_TOP_MFG_PLL_SEL)) {
+		printf("SWEETMALI: mfg_pll_sel did not latch (%x)\n",
+		    sm_rd(sm.top + SM_TOP_CLK_CFG_4));
+		return -2;
+	}
+
+	/*
+	 * mfgcfg_bg3d is a setclr gate: enabled reads back as status bit 0
+	 * being zero, and the clear register is what enables it.
+	 */
+	uint32_t before = sm_rd(sm.mfg + SM_MFG_BG3D_STA);
+	sm_wr(sm.mfg + SM_MFG_BG3D_CLR, SM_MFG_BG3D_BIT);
+	if (sm_wait(sm.mfg + SM_MFG_BG3D_STA, SM_MFG_BG3D_BIT, 0u)) {
+		printf("SWEETMALI: BG3D gate did not open (before=%x after=%x)\n",
+		    before, sm_rd(sm.mfg + SM_MFG_BG3D_STA));
+		return -3;
+	}
+
+	sm_external_gates_on();
+	printf("SWEETMALI: main clock on CFG4=%x MFG_STATUS=%x\n",
+	    sm_rd(sm.top + SM_TOP_CLK_CFG_4), sm_rd(sm.mfg + 0x00u));
+	return 0;
+}
+
+static int
+sm_power_and_clock(void)
+{
+	printf("SWEETMALI: power before STA=%x/%x CON=%x,%x,%x,%x\n",
+	    sm_rd(sm.scpsys + SM_PWR_STATUS),
+	    sm_rd(sm.scpsys + SM_PWR_STATUS2),
+	    sm_rd(sm.scpsys + SM_MFG0_PWR_CON),
+	    sm_rd(sm.scpsys + SM_MFG1_PWR_CON),
+	    sm_rd(sm.scpsys + SM_MFG2_PWR_CON),
+	    sm_rd(sm.scpsys + SM_MFG3_PWR_CON));
+
+	if (sm_mtcmos_on(SM_MFG0_PWR_CON, SM_MFG0_STA, "mfg0")) {
+		return -3;
+	}
+	if (sm_mtcmos_on(SM_MFG1_PWR_CON, SM_MFG1_STA, "mfg1")) {
+		return -4;
+	}
+	sm_mfg1_clear_protection();
+	if (sm_ref_clock_on()) {
+		printf("SWEETMALI: mfg_ref clock is gated\n");
+		return -2;
+	}
+	if (sm_mtcmos_on(SM_MFG2_PWR_CON, SM_MFG2_STA, "mfg2")) {
+		return -5;
+	}
+	if (sm_mtcmos_on(SM_MFG3_PWR_CON, SM_MFG3_STA, "mfg3")) {
+		return -6;
+	}
+
+	int rc = sm_main_clock_on();
+	if (rc) {
+		return rc;
+	}
+	printf("SWEETMALI: power after STA=%x/%x\n",
+	    sm_rd(sm.scpsys + SM_PWR_STATUS),
+	    sm_rd(sm.scpsys + SM_PWR_STATUS2));
+	return 0;
+}
+
+static int
+sm_soft_reset(void)
+{
+	sm_wr(sm.gpu + SM_GPU_INT_MASK, 0);
+	sm_wr(sm.gpu + SM_GPU_INT_CLEAR, SM_GPU_IRQ_RESET_COMPLETED);
+	sm_wr(sm.gpu + SM_GPU_CMD, SM_GPU_CMD_SOFT_RESET);
+
+	if (sm_wait(sm.gpu + SM_GPU_INT_RAWSTAT,
+	    SM_GPU_IRQ_RESET_COMPLETED, SM_GPU_IRQ_RESET_COMPLETED)) {
+		printf("SWEETMALI: soft reset timeout, trying hard reset\n");
+		sm_wr(sm.gpu + SM_GPU_CMD, SM_GPU_CMD_HARD_RESET);
+		if (sm_wait(sm.gpu + SM_GPU_INT_RAWSTAT,
+		    SM_GPU_IRQ_RESET_COMPLETED, SM_GPU_IRQ_RESET_COMPLETED)) {
+			printf("SWEETMALI: hard reset timeout RAWSTAT=%x STATUS=%x\n",
+			    sm_rd(sm.gpu + SM_GPU_INT_RAWSTAT),
+			    sm_rd(sm.gpu + SM_GPU_STATUS));
+			return -1;
+		}
+	}
+	sm_wr(sm.gpu + SM_GPU_INT_CLEAR, 0xffffffffu);
+	sm_wr(sm.gpu + SM_GPU_INT_MASK, 0);
+	printf("SWEETMALI: reset complete RAWSTAT=%x STATUS=%x\n",
+	    sm_rd(sm.gpu + SM_GPU_INT_RAWSTAT),
+	    sm_rd(sm.gpu + SM_GPU_STATUS));
+	return 0;
+}
+
+static void
+sm_read_features(void)
+{
+	uint32_t gpu_id = sm_rd(sm.gpu + SM_GPU_ID);
+
+	sm.gpu_id = gpu_id >> 16;
+	sm.revision = gpu_id & 0xffffu;
+	sm.l2_present = sm_rd(sm.gpu + SM_GPU_L2_PRESENT_LO);
+	sm.shader_present = sm_rd(sm.gpu + SM_GPU_SHADER_PRESENT_LO);
+	sm.tiler_present = sm_rd(sm.gpu + SM_GPU_TILER_PRESENT_LO);
+	sm.as_present = sm_rd(sm.gpu + SM_GPU_AS_PRESENT);
+	sm.js_present = sm_rd(sm.gpu + SM_GPU_JS_PRESENT);
+	sm.mmu_features = sm_rd(sm.gpu + SM_GPU_MMU_FEATURES);
+	sm.mem_features = sm_rd(sm.gpu + SM_GPU_MEM_FEATURES);
+	sm.thread_features = sm_rd(sm.gpu + SM_GPU_THREAD_FEATURES);
+	sm.coherency_features = sm_rd(sm.gpu + SM_GPU_COHERENCY_FEATURES);
+	sm.max_threads = sm_rd(sm.gpu + SM_GPU_THREAD_MAX_THREADS);
+	sm.max_workgroup = sm_rd(sm.gpu + SM_GPU_THREAD_MAX_WG);
+	sm.max_barrier = sm_rd(sm.gpu + SM_GPU_THREAD_MAX_BARRIER);
+
+	printf("SWEETMALI: ID=%x model=%x rev=%x\n", gpu_id,
+	    sm.gpu_id, sm.revision);
+	printf("SWEETMALI: L2=%x SHADER=%x TILER=%x STACK=%x\n",
+	    sm.l2_present, sm.shader_present, sm.tiler_present,
+	    sm_rd(sm.gpu + SM_GPU_STACK_PRESENT_LO));
+	printf("SWEETMALI: AS=%x JS=%x MMU=%x MEM=%x\n",
+	    sm.as_present, sm.js_present, sm.mmu_features, sm.mem_features);
+	printf("SWEETMALI: threads=%u wg=%u barrier=%u feat=%x coh=%x\n",
+	    sm.max_threads, sm.max_workgroup, sm.max_barrier,
+	    sm.thread_features, sm.coherency_features);
+	printf("SWEETMALI: L2_FEAT=%x CORE_FEAT=%x TILER_FEAT=%x AFBC=%x\n",
+	    sm_rd(sm.gpu + SM_GPU_L2_FEATURES),
+	    sm_rd(sm.gpu + SM_GPU_CORE_FEATURES),
+	    sm_rd(sm.gpu + SM_GPU_TILER_FEATURES),
+	    sm_rd(sm.gpu + SM_GPU_AFBC_FEATURES));
+	printf("SWEETMALI: texture=%x,%x,%x,%x JS_FEAT=%x,%x,%x,%x\n",
+	    sm_rd(sm.gpu + SM_GPU_TEXTURE_FEATURES(0)),
+	    sm_rd(sm.gpu + SM_GPU_TEXTURE_FEATURES(1)),
+	    sm_rd(sm.gpu + SM_GPU_TEXTURE_FEATURES(2)),
+	    sm_rd(sm.gpu + SM_GPU_TEXTURE_FEATURES(3)),
+	    sm_rd(sm.gpu + SM_GPU_JS_FEATURES(0)),
+	    sm_rd(sm.gpu + SM_GPU_JS_FEATURES(1)),
+	    sm_rd(sm.gpu + SM_GPU_JS_FEATURES(2)),
+	    sm_rd(sm.gpu + SM_GPU_JS_FEATURES(3)));
+	printf("SWEETMALI: TLS_ALLOC=%x\n",
+	    sm_rd(sm.gpu + SM_GPU_THREAD_TLS_ALLOC));
+}
+
+static void
+sm_apply_g57_quirks(void)
+{
+	/*
+	 * panfrost_model_cmp() folds the arch revision nibble away, so
+	 * MT6789's 0x9093 matches the 0x9003 G57 entry.  Apply the same
+	 * quirks the shim validated: SC_VAR_ALGORITHM and the default IDVS
+	 * group size.
+	 */
+	uint32_t model = sm.gpu_id;
+
+	if (model & 0xf000u) {
+		model &= 0xf00fu;
+	}
+	if ((model == 0x9001u) || (model == 0x9003u)) {
+		uint32_t shader = sm_rd(sm.gpu + SM_GPU_SHADER_CONFIG);
+
+		sm_wr(sm.gpu + SM_GPU_SHADER_CONFIG, SM_SC_VAR_ALGORITHM);
+		printf("SWEETMALI: SHADER_CONFIG %x -> %x\n", shader,
+		    sm_rd(sm.gpu + SM_GPU_SHADER_CONFIG));
+
+		uint32_t jm = sm_rd(sm.gpu + SM_GPU_JM_CONFIG);
+
+		sm_wr(sm.gpu + SM_GPU_JM_CONFIG, SM_JM_DEFAULT_IDVS_GROUP);
+		printf("SWEETMALI: JM_CONFIG %x -> %x\n", jm,
+		    sm_rd(sm.gpu + SM_GPU_JM_CONFIG));
+	}
+}
+
+static int
+sm_power_units_on(void)
+{
+	if (!sm.l2_present || !sm.shader_present || !sm.tiler_present) {
+		printf("SWEETMALI: impossible present map L2=%x SHADER=%x TILER=%x\n",
+		    sm.l2_present, sm.shader_present, sm.tiler_present);
+		return -1;
+	}
+
+	sm_wr(sm.gpu + SM_GPU_L2_PWRON_LO, sm.l2_present);
+	if (sm_wait(sm.gpu + SM_GPU_L2_READY_LO,
+	    sm.l2_present, sm.l2_present)) {
+		printf("SWEETMALI: L2 power timeout READY=%x\n",
+		    sm_rd(sm.gpu + SM_GPU_L2_READY_LO));
+		return -2;
+	}
+
+	sm_wr(sm.gpu + SM_GPU_SHADER_PWRON_LO, sm.shader_present);
+	if (sm_wait(sm.gpu + SM_GPU_SHADER_READY_LO,
+	    sm.shader_present, sm.shader_present)) {
+		printf("SWEETMALI: shader power timeout READY=%x\n",
+		    sm_rd(sm.gpu + SM_GPU_SHADER_READY_LO));
+		return -3;
+	}
+
+	sm_wr(sm.gpu + SM_GPU_TILER_PWRON_LO, sm.tiler_present);
+	if (sm_wait(sm.gpu + SM_GPU_TILER_READY_LO,
+	    sm.tiler_present, sm.tiler_present)) {
+		printf("SWEETMALI: tiler power timeout READY=%x\n",
+		    sm_rd(sm.gpu + SM_GPU_TILER_READY_LO));
+		return -4;
+	}
+
+	printf("SWEETMALI: ready L2=%x SHADER=%x TILER=%x\n",
+	    sm_rd(sm.gpu + SM_GPU_L2_READY_LO),
+	    sm_rd(sm.gpu + SM_GPU_SHADER_READY_LO),
+	    sm_rd(sm.gpu + SM_GPU_TILER_READY_LO));
+	return 0;
+}
+
+static uint64_t
+sm_page_table_desc(uint64_t pa)
+{
+	return (pa & ~0xfffull) | SM_LPAE_TABLE_DESC;
+}
+
+static uint64_t
+sm_page_block_desc(uint64_t pa)
+{
+	return (pa & ~(SM_MALI_BLOCK_2M - 1ull)) | SM_LPAE_LEAF_DESC |
+	    SM_LPAE_SH_OS | SM_LPAE_HAP_READ | SM_LPAE_HAP_WRITE;
+}
+
+/*
+ * A 4 KiB page descriptor differs from a 2 MiB block only in the address
+ * mask: the descriptor type is 0b01 for both (see the note on
+ * SM_LPAE_LEAF_DESC -- probe 12 used 0b11 here and the walk faulted).
+ */
+static uint64_t
+sm_page_desc(uint64_t pa)
+{
+	return (pa & ~0xfffull) | SM_LPAE_LEAF_DESC | SM_LPAE_SH_OS |
+	    SM_LPAE_HAP_READ | SM_LPAE_HAP_WRITE;
+}
+
+static void
+sm_cache_clean_invalidate(vm_offset_t addr, vm_size_t size)
+{
+	const vm_offset_t line = 64;
+	vm_offset_t start = addr & ~(line - 1);
+	vm_offset_t end = (addr + size + line - 1) & ~(line - 1);
+	vm_offset_t p;
+
+	for (p = start; p < end; p += line) {
+		__asm__ volatile("dc civac, %0" :: "r"(p) : "memory");
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+	__asm__ volatile("isb" ::: "memory");
+}
+
+/*
+ * Identity-map one naturally aligned 2 MiB block: IOVA == physical.  The
+ * descriptors must contain the physical addresses of the next-level tables,
+ * not their kernel virtual addresses.
+ */
+static void
+sm_map_2m(uint64_t pa)
+{
+	uint64_t base = pa & ~(SM_MALI_BLOCK_2M - 1ull);
+	uint32_t pgd_index = (uint32_t)((base >> 39) & 0x1ffull);
+	uint32_t pud_index = (uint32_t)((base >> 30) & 0x1ffull);
+	uint32_t pmd_index = (uint32_t)((base >> 21) & 0x1ffull);
+	uint64_t *tables = sm_pt_tables;
+
+	tables[pgd_index] = sm_page_table_desc(sm_pt_base + SM_GPU_PAGE_SIZE);
+	tables[512 + pud_index] =
+	    sm_page_table_desc(sm_pt_base + 2ull * SM_GPU_PAGE_SIZE);
+	tables[1024 + pmd_index] = sm_page_block_desc(base);
+}
+
+/*
+ * All MMU commands and flushes take the address space explicitly: AS0 is the
+ * probe's own, AS1 is the second one A4 adds, and each has its own register
+ * block at SM_MMU_AS(as) with its own LOCKADDR/COMMAND/STATUS/FAULTSTATUS.
+ */
+static int
+sm_mmu_wait_ready(uint32_t as)
+{
+	for (uint32_t i = 0; i < SM_TIMEOUT_STEPS; i++) {
+		if (!(sm_rd(sm.gpu + SM_AS_STATUS(as)) &
+		    SM_AS_STATUS_AS_ACTIVE)) {
+			return 0;
+		}
+		delay(SM_TIMEOUT_US);
+	}
+	return -1;
+}
+
+static int
+sm_mmu_command(uint32_t as, uint32_t command)
+{
+	if (sm_mmu_wait_ready(as)) {
+		return -1;
+	}
+	sm_wr(sm.gpu + SM_AS_COMMAND(as), command);
+	return sm_mmu_wait_ready(as);
+}
+
+/*
+ * Highest set bit of x, 1-based (fls64); 0 for 0.
+ */
+static uint32_t
+sm_fls64(uint64_t x)
+{
+	uint32_t n = 0;
+
+	while (x) {
+		x >>= 1;
+		n++;
+	}
+	return n;
+}
+
+/*
+ * Invalidate the MMU's cached page-table walk for [va, va + size), so a PTE
+ * that was just changed is seen.  Exactly Panfrost's sequence: lock the
+ * region (AS_LOCKADDR = log2(size) - 1 | aligned start), AS_COMMAND_FLUSH_PT,
+ * then unlock.  Without it the MMU keeps translating through the entry it
+ * cached and an unmap appears to do nothing.
+ */
+static int
+sm_as_flush_pt(uint32_t as, uint64_t va, uint64_t size)
+{
+	uint32_t width;
+	uint64_t region;
+	int rc;
+
+	if (!size) {
+		return 0;
+	}
+	/* Highest bit in which start and end-1 differ: the smallest
+	 * naturally aligned block that covers the whole region. */
+	width = sm_fls64(va ^ (va + size - 1ull));
+	if (width < SM_AS_LOCK_MIN_LOG2) {
+		width = SM_AS_LOCK_MIN_LOG2;
+	}
+	width -= 1u;
+	region = (va & ~((1ull << width) - 1ull)) | (uint64_t)width;
+	sm_wr(sm.gpu + SM_AS_LOCKADDR_LO(as), (uint32_t)region);
+	sm_wr(sm.gpu + SM_AS_LOCKADDR_HI(as), (uint32_t)(region >> 32));
+	if (sm_mmu_command(as, SM_AS_COMMAND_LOCK)) {
+		return -1;
+	}
+	rc = sm_mmu_command(as, SM_AS_COMMAND_FLUSH_PT);
+	if (sm_mmu_command(as, SM_AS_COMMAND_UNLOCK)) {
+		return -3;
+	}
+	return rc;
+}
+
+static int
+sm_mmu_configure_as(uint32_t as, uint64_t pgd_pa)
+{
+	uint64_t transtab;
+
+	sm_wr(sm.gpu + SM_MMU_INT_MASK, 0);
+	sm_wr(sm.gpu + SM_MMU_INT_CLEAR, 0xffffffffu);
+
+	if (sm_mmu_wait_ready(as)) {
+		return -1;
+	}
+
+	/* Same lock/flush/update sequence as Panfrost and the shim. */
+	sm_wr(sm.gpu + SM_AS_LOCKADDR_LO(as), 63u);
+	sm_wr(sm.gpu + SM_AS_LOCKADDR_HI(as), 0);
+	if (sm_mmu_command(as, SM_AS_COMMAND_LOCK)) {
+		return -2;
+	}
+	if (sm_mmu_command(as, SM_AS_COMMAND_FLUSH_MEM)) {
+		return -3;
+	}
+
+	transtab = pgd_pa | SM_AS_TRANSTAB_MODE_TABLE |
+	    SM_AS_TRANSTAB_READ_INNER;
+	sm_wr(sm.gpu + SM_AS_TRANSTAB_LO(as), (uint32_t)transtab);
+	sm_wr(sm.gpu + SM_AS_TRANSTAB_HI(as), (uint32_t)(transtab >> 32));
+	sm_wr(sm.gpu + SM_AS_MEMATTR_LO(as), SM_MALI_MEMATTR);
+	sm_wr(sm.gpu + SM_AS_MEMATTR_HI(as), 0);
+	if (sm_mmu_command(as, SM_AS_COMMAND_UPDATE)) {
+		return -4;
+	}
+
+	printf("SWEETMALI: MMU AS%u TT=%x%x STATUS=%x MEMATTR=%x\n", as,
+	    sm_rd(sm.gpu + SM_AS_TRANSTAB_HI(as)),
+	    sm_rd(sm.gpu + SM_AS_TRANSTAB_LO(as)),
+	    sm_rd(sm.gpu + SM_AS_STATUS(as)),
+	    sm_rd(sm.gpu + SM_AS_MEMATTR_LO(as)));
+	return 0;
+}
+
+/*
+ * Contiguous kernel allocation with a known physical address.  Passing NULL
+ * as IOMallocContiguous' physicalAddress argument takes the unrestricted
+ * kmem_alloc_contig path (the deprecated physicalAddress form builds a 32-bit
+ * physical mask, which fails here because free DRAM lives above 4 GiB).
+ */
+static vm_offset_t
+sm_alloc_contig(vm_size_t size, vm_size_t alignment, uint64_t *pa)
+{
+	void *kva;
+
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wdeprecated-declarations"
+	kva = IOMallocContiguous(size, alignment, NULL);
+#pragma clang diagnostic pop
+
+	if (!kva) {
+		*pa = 0;
+		return 0;
+	}
+	*pa = (uint64_t)ml_vtophys((vm_offset_t)kva);
+	return (vm_offset_t)kva;
+}
+
+static int
+sm_mmu_alloc(void)
+{
+	uint64_t heap_size = SM_TILER_HEAP_SIZE;
+	int attempt;
+
+	sm.tables = sm_alloc_contig(SM_TABLES_TOTAL_PAGES * SM_GPU_PAGE_SIZE,
+	    SM_GPU_PAGE_SIZE, &sm.tables_pa);
+	sm.as1_tables = sm_alloc_contig(SM_TABLES_PAGES * SM_GPU_PAGE_SIZE,
+	    SM_GPU_PAGE_SIZE, &sm.as1_tables_pa);
+	sm.job = sm_alloc_contig(SM_GPU_PAGE_SIZE, SM_GPU_PAGE_SIZE,
+	    &sm.job_pa);
+	sm.target = sm_alloc_contig(SM_GPU_PAGE_SIZE, SM_GPU_PAGE_SIZE,
+	    &sm.target_pa);
+	sm.tri = sm_alloc_contig(SM_GPU_PAGE_SIZE, SM_GPU_PAGE_SIZE,
+	    &sm.tri_pa);
+	sm.zero = sm_alloc_contig(SM_GPU_PAGE_SIZE, SM_GPU_PAGE_SIZE,
+	    &sm.zero_pa);
+	if (sm.zero) {
+		volatile uint32_t *zp = (volatile uint32_t *)sm.zero;
+
+		for (attempt = 0; attempt < (int)(SM_GPU_PAGE_SIZE / 4u);
+		    attempt++) {
+			zp[attempt] = 0;
+		}
+		sm_cache_clean_invalidate(sm.zero, SM_GPU_PAGE_SIZE);
+	}
+
+	/*
+	 * Tiler heap: try progressively smaller physically contiguous blocks.
+	 * A page-aligned block is what upstream allocates; 32 MiB is the size
+	 * the shim proved.  The chunk enum in the heap descriptor is derived
+	 * from the size that actually succeeded.
+	 */
+	sm.heap = 0;
+	sm.heap_pa = 0;
+	for (attempt = 0; attempt < 4; attempt++) {
+		sm.heap = sm_alloc_contig((vm_size_t)heap_size,
+		    SM_GPU_PAGE_SIZE, &sm.heap_pa);
+		if (sm.heap) {
+			break;
+		}
+		heap_size >>= 2;
+	}
+	sm.heap_size = heap_size;
+
+	if (!sm.tables || !sm.as1_tables || !sm.job || !sm.target || !sm.tri ||
+	    !sm.heap || !sm.zero) {
+		printf("SWEETMALI: DMA alloc failed tables=%lx as1=%lx job=%lx "
+		    "target=%lx tri=%lx heap=%lx zero=%lx\n", sm.tables,
+		    sm.as1_tables, sm.job, sm.target, sm.tri, sm.heap, sm.zero);
+		return -1;
+	}
+
+	/*
+	 * The kernel's io_submap is only 8 MiB, far smaller than the panel
+	 * framebuffer.  Map just the first page here (poison marker); pixel
+	 * pages are mapped on demand in sm_fb_read_pixel().
+	 */
+	sm.fb_map = ml_io_map((vm_offset_t)SM_PANEL_FB_PA, SM_GPU_PAGE_SIZE);
+	if (!sm.fb_map) {
+		printf("SWEETMALI: panel fb map failed\n");
+		return -1;
+	}
+
+	printf("SWEETMALI: DMA tables=%lx/%llx job=%lx/%llx target=%lx/%llx\n",
+	    sm.tables, sm.tables_pa, sm.job, sm.job_pa, sm.target, sm.target_pa);
+	printf("SWEETMALI: DMA tri=%lx/%llx heap=%lx/%llx size=%llx fb=%lx\n",
+	    sm.tri, sm.tri_pa, sm.heap, sm.heap_pa, sm.heap_size, sm.fb_map);
+	return 0;
+}
+
+static void
+sm_map_range(uint64_t start, uint64_t end)
+{
+	uint64_t pa;
+
+	for (pa = start & ~(SM_MALI_BLOCK_2M - 1ull); pa < end;
+	    pa += SM_MALI_BLOCK_2M) {
+		sm_map_2m(pa);
+	}
+}
+
+/*
+ * Map one 2 MiB physical block at an arbitrary 2 MiB aligned VA.  Both the
+ * VA and the PA are aligned down, so the offset of a byte inside its block
+ * is preserved and "VA of X == va + (pa(X) & (2 MiB - 1))" holds.
+ *
+ * The window must *not* share the identity maps' PMD table.  A PMD entry is
+ * selected by VA bits 29:21 alone, so a shared table would silently make the
+ * two mappings overwrite each other's 2 MiB blocks -- exactly the probe-10
+ * failure, where the heap window landed on the heap's own identity entries
+ * and sent every later identity fetch 8 MiB off.  The window therefore owns
+ * tables page 3 and is reached through its own PUD entry (the identity maps
+ * only ever use PUD 0..7, since every PA here is below 8 GiB).
+ */
+static void
+sm_map_2m_at(uint64_t va, uint64_t pa)
+{
+	uint64_t vbase = va & ~(SM_MALI_BLOCK_2M - 1ull);
+	uint64_t pbase = pa & ~(SM_MALI_BLOCK_2M - 1ull);
+	uint32_t pgd_index = (uint32_t)((vbase >> 39) & 0x1ffull);
+	uint32_t pud_index = (uint32_t)((vbase >> 30) & 0x1ffull);
+	uint32_t pmd_index = (uint32_t)((vbase >> 21) & 0x1ffull);
+	uint64_t *tables = sm_pt_tables;
+	uint64_t *pmd = &tables[SM_VA_PMD_PAGE * 512u];
+
+	if (pud_index != SM_VA_PUD_INDEX) {
+		printf("SWEETMALI: VA %llx outside the window's PUD (%u)\n",
+		    (unsigned long long)va, pud_index);
+		return;
+	}
+	tables[pgd_index] = sm_page_table_desc(sm_pt_base + SM_GPU_PAGE_SIZE);
+	tables[512 + pud_index] = sm_page_table_desc(
+	    sm_pt_base + (uint64_t)SM_VA_PMD_PAGE * SM_GPU_PAGE_SIZE);
+	pmd[pmd_index] = sm_page_block_desc(pbase);
+}
+
+/*
+ * Map [pa, pa + bytes) a second time starting at the 2 MiB aligned VA
+ * "va".  The caller must pass an aligned va; every byte keeps its offset
+ * inside its own block, so a buffer at pa + k lives at va + off + k.
+ */
+static void
+sm_map_range_at(uint64_t va, uint64_t pa, uint64_t bytes)
+{
+	uint64_t off = pa & (SM_MALI_BLOCK_2M - 1ull);
+	uint64_t pbase = pa - off;
+	uint64_t x;
+
+	for (x = 0; x < bytes + off; x += SM_MALI_BLOCK_2M) {
+		sm_map_2m_at(va + x, pbase + x);
+	}
+}
+
+/*
+ * Map one 4 KiB page at an arbitrary 4 KiB aligned VA, using the window's
+ * dedicated PTE table (tables page 4) reached through PMD entry
+ * SM_VA_PMD4K_INDEX.  No neighbouring page is mapped, so a read of the next
+ * page faults instead of silently hitting another page of the same block --
+ * that is what proves the walk really stopped at 4 KiB granularity rather
+ * than rounding out to a 2 MiB block.
+ */
+static void
+sm_map_4k_at(uint64_t va, uint64_t pa)
+{
+	uint32_t pgd_index = (uint32_t)((va >> 39) & 0x1ffull);
+	uint32_t pud_index = (uint32_t)((va >> 30) & 0x1ffull);
+	uint32_t pmd_index = (uint32_t)((va >> 21) & 0x1ffull);
+	uint32_t pte_index = (uint32_t)((va >> 12) & 0x1ffull);
+	uint64_t *tables = sm_pt_tables;
+	uint64_t *pmd = &tables[SM_VA_PMD_PAGE * 512u];
+	uint64_t *pte = &tables[SM_VA_PTE_PAGE * 512u];
+
+	if (pud_index != SM_VA_PUD_INDEX || pmd_index != SM_VA_PMD4K_INDEX) {
+		printf("SWEETMALI: VA %llx outside the 4K window (pud %u pmd "
+		    "%u)\n", (unsigned long long)va, pud_index, pmd_index);
+		return;
+	}
+	tables[pgd_index] = sm_page_table_desc(sm_pt_base + SM_GPU_PAGE_SIZE);
+	tables[512 + pud_index] = sm_page_table_desc(
+	    sm_pt_base + (uint64_t)SM_VA_PMD_PAGE * SM_GPU_PAGE_SIZE);
+	pmd[pmd_index] = sm_page_table_desc(
+	    sm_pt_base + (uint64_t)SM_VA_PTE_PAGE * SM_GPU_PAGE_SIZE);
+	pte[pte_index] = sm_page_desc(pa);
+}
+
+/*
+ * Rewrite that one 4 KiB PTE and make the MMU drop the walk it cached for the
+ * page: pa == 0 unmaps, any other pa re-points it.  This is the BO lifecycle
+ * (map, unmap, map somewhere else) at the page level, and the flush is what
+ * makes it observable -- the case that follows an unmap has to fault.
+ */
+static int
+sm_pte4k_set(uint32_t as, uint64_t va, uint64_t pa)
+{
+	uint32_t pgd_index = (uint32_t)((va >> 39) & 0x1ffull);
+	uint32_t pud_index = (uint32_t)((va >> 30) & 0x1ffull);
+	uint32_t pmd_index = (uint32_t)((va >> 21) & 0x1ffull);
+	uint32_t pte_index = (uint32_t)((va >> 12) & 0x1ffull);
+	uint64_t *tables;
+	uint64_t *pmd;
+	uint64_t *pte;
+
+	if (pud_index != SM_VA_PUD_INDEX || pmd_index != SM_VA_PMD4K_INDEX) {
+		printf("SWEETMALI: PTE4K %llx outside the 4K window\n",
+		    (unsigned long long)va);
+		return -1;
+	}
+	sm_pt_select(as);
+	tables = sm_pt_tables;
+	pmd = &tables[SM_VA_PMD_PAGE * 512u];
+	pte = &tables[SM_VA_PTE_PAGE * 512u];
+	tables[pgd_index] = sm_page_table_desc(sm_pt_base + SM_GPU_PAGE_SIZE);
+	tables[512 + pud_index] = sm_page_table_desc(
+	    sm_pt_base + (uint64_t)SM_VA_PMD_PAGE * SM_GPU_PAGE_SIZE);
+	pmd[pmd_index] = sm_page_table_desc(
+	    sm_pt_base + (uint64_t)SM_VA_PTE_PAGE * SM_GPU_PAGE_SIZE);
+	pte[pte_index] = pa ? sm_page_desc(pa) : 0ull;
+	sm_cache_clean_invalidate(sm_pt_tables,
+	    SM_TABLES_PAGES * SM_GPU_PAGE_SIZE);
+	return sm_as_flush_pt(as, va & ~0xfffull, SM_GPU_PAGE_SIZE);
+}
+
+/*
+ * ---------------------------------------------------------------------------
+ * A3: the GPU VA allocator and its table-page pool
+ * ---------------------------------------------------------------------------
+ * Everything here works on AS0's table set and only ever touches the area's
+ * own PUD entry (258), so the identity maps, the VA window and the 4 KiB
+ * window are structurally out of reach.
+ */
+
+/* PA of pool page `idx`; the pool is the tail of the one contiguous table
+ * allocation, so a PA inside it is an offset away from the kernel VA. */
+static uint64_t
+sm_pool_pa(uint32_t idx)
+{
+	return sm.tables_pa + (uint64_t)(SM_TABLES_PAGES + idx) *
+	    SM_GPU_PAGE_SIZE;
+}
+
+static uint64_t *
+sm_pt_at(uint64_t pa)
+{
+	return (uint64_t *)(sm.tables + (pa - sm.tables_pa));
+}
+
+/* Take one zeroed page from the pool.  Returns its pool index, or -1. */
+static int
+sm_pool_take(void)
+{
+	uint64_t *p;
+	uint32_t idx;
+
+	if (sm.pool_used >= SM_TABLE_POOL_PAGES) {
+		return -1;
+	}
+	idx = sm.pool_used++;
+	p = sm_pt_at(sm_pool_pa(idx));
+	for (uint32_t i = 0; i < 512u; i++) {
+		p[i] = 0;
+	}
+	sm_cache_clean_invalidate((vm_offset_t)p, SM_GPU_PAGE_SIZE);
+	return (int)idx;
+}
+
+/* The PTE page of one area PMD entry, created from the pool on first touch. */
+static uint64_t *
+sm_area_pte_page(uint32_t pmd_index)
+{
+	int idx;
+
+	if (!sm.area_pmd) {
+		idx = sm_pool_take();
+		if (idx < 0) {
+			return NULL;
+		}
+		sm.area_pmd = sm_pt_at(sm_pool_pa((uint32_t)idx));
+		sm_pt_tables[512 + SM_VA_AREA_PUD_INDEX] =
+		    sm_page_table_desc(sm_pool_pa((uint32_t)idx));
+	}
+	if ((sm.area_pmd[pmd_index] & 3ull) != SM_LPAE_TABLE_DESC) {
+		idx = sm_pool_take();
+		if (idx < 0) {
+			return NULL;
+		}
+		sm.area_pmd[pmd_index] =
+		    sm_page_table_desc(sm_pool_pa((uint32_t)idx));
+	}
+	return sm_pt_at(sm.area_pmd[pmd_index] & ~0xfffull);
+}
+
+/* First fit, contiguous, 4 KiB granular.  Returns the VA, or 0. */
+static uint64_t
+sm_va_alloc(uint32_t pages)
+{
+	uint32_t run = 0;
+
+	if (!pages || pages > SM_VA_AREA_PAGES) {
+		return 0;
+	}
+	for (uint32_t i = 0; i < SM_VA_AREA_PAGES; i++) {
+		if (sm.va_used[i >> 5] & (1u << (i & 31u))) {
+			run = 0;
+			continue;
+		}
+		if (++run == pages) {
+			uint32_t first = i + 1u - pages;
+
+			for (uint32_t j = first; j <= i; j++) {
+				sm.va_used[j >> 5] |= 1u << (j & 31u);
+			}
+			return SM_VA_AREA_BASE +
+			    (uint64_t)first * SM_GPU_PAGE_SIZE;
+		}
+	}
+	return 0;
+}
+
+static void
+sm_va_free(uint64_t va, uint32_t pages)
+{
+	uint32_t first;
+
+	if (va < SM_VA_AREA_BASE) {
+		return;
+	}
+	first = (uint32_t)((va - SM_VA_AREA_BASE) / SM_GPU_PAGE_SIZE);
+	for (uint32_t j = 0; j < pages && first + j < SM_VA_AREA_PAGES; j++) {
+		sm.va_used[(first + j) >> 5] &= ~(1u << ((first + j) & 31u));
+	}
+}
+
+/*
+ * Map [pa, pa + size) at [va, va + size) with 4 KiB pages.  Unlike
+ * sm_pt_build()'s windows, whose tables exist because boot wrote them, here
+ * nothing exists until it is asked for: the area's PMD page and each PMD
+ * entry's PTE page come out of the pool zeroed at this moment, and the
+ * POOL counter is the evidence.
+ */
+static int
+sm_va_map_4k(uint64_t va, uint64_t pa, uint64_t size)
+{
+	uint64_t aligned = va & ~(SM_GPU_PAGE_SIZE - 1ull);
+	uint64_t pages = (size + SM_GPU_PAGE_SIZE - 1ull) / SM_GPU_PAGE_SIZE;
+
+	if (!aligned || ((aligned >> 39) & 0x1ffull) ||
+	    ((aligned >> 30) & 0x1ffull) != SM_VA_AREA_PUD_INDEX ||
+	    ((aligned + size - 1ull) >> 30 & 0x1ffull) !=
+	    SM_VA_AREA_PUD_INDEX) {
+		return -1;
+	}
+	sm_pt_select(0);
+	sm_pt_tables[0] = sm_page_table_desc(sm_pt_base + SM_GPU_PAGE_SIZE);
+	for (uint64_t i = 0; i < pages; i++) {
+		uint64_t v = aligned + i * SM_GPU_PAGE_SIZE;
+		uint32_t pmd_index = (uint32_t)((v >> 21) & 0x1ffull);
+		uint32_t pte_index = (uint32_t)((v >> 12) & 0x1ffull);
+		uint64_t *pte = sm_area_pte_page(pmd_index);
+
+		if (!pte) {
+			return -2;
+		}
+		pte[pte_index] = sm_page_desc(pa + i * SM_GPU_PAGE_SIZE);
+	}
+	sm_cache_clean_invalidate(sm.tables,
+	    SM_TABLES_TOTAL_PAGES * SM_GPU_PAGE_SIZE);
+	return sm_as_flush_pt(0, aligned, pages * SM_GPU_PAGE_SIZE);
+}
+
+/*
+ * Clear the leaf entries of a mapping.  The table pages stay in the pool --
+ * a driver reclaims empty tables lazily -- but the FLUSH_PT is what makes
+ * the unmap visible, exactly as in sm_pte4k_set().
+ */
+static void
+sm_va_unmap(uint64_t va, uint64_t size)
+{
+	uint64_t aligned = va & ~(SM_GPU_PAGE_SIZE - 1ull);
+	uint64_t pages = (size + SM_GPU_PAGE_SIZE - 1ull) / SM_GPU_PAGE_SIZE;
+
+	if (!aligned || !sm.area_pmd) {
+		return;
+	}
+	sm_pt_select(0);
+	for (uint64_t i = 0; i < pages; i++) {
+		uint64_t v = aligned + i * SM_GPU_PAGE_SIZE;
+		uint32_t pmd_index = (uint32_t)((v >> 21) & 0x1ffull);
+		uint32_t pte_index = (uint32_t)((v >> 12) & 0x1ffull);
+
+		if ((sm.area_pmd[pmd_index] & 3ull) != SM_LPAE_TABLE_DESC) {
+			continue;
+		}
+		sm_pt_at(sm.area_pmd[pmd_index] & ~0xfffull)[pte_index] = 0;
+	}
+	sm_cache_clean_invalidate(sm.tables,
+	    SM_TABLES_TOTAL_PAGES * SM_GPU_PAGE_SIZE);
+	(void)sm_as_flush_pt(0, aligned, pages * SM_GPU_PAGE_SIZE);
+}
+
+/*
+ * ---------------------------------------------------------------------------
+ * B1: BO handles
+ * ---------------------------------------------------------------------------
+ */
+
+static void
+sm_bo_free_mem(vm_offset_t kva, uint64_t size)
+{
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wdeprecated-declarations"
+	IOFreeContiguous((void *)kva, (vm_size_t)size);
+#pragma clang diagnostic pop
+}
+
+/*
+ * Open a BO in `slot`: one contiguous physical allocation plus a VA the
+ * allocator picks and maps.  Idempotent, so a case can name an existing BO
+ * (that is how "the same VA works again later" is stated).
+ */
+static int
+sm_bo_open(uint32_t slot, uint64_t size)
+{
+	uint32_t pages = (uint32_t)((size + SM_GPU_PAGE_SIZE - 1ull) /
+	    SM_GPU_PAGE_SIZE);
+	uint64_t pa = 0;
+	uint64_t va;
+	vm_offset_t kva;
+
+	if (slot >= SM_BO_MAX) {
+		return -1;
+	}
+	if (sm.bo[slot].used) {
+		return 0;
+	}
+	kva = sm_alloc_contig((vm_size_t)size, SM_GPU_PAGE_SIZE, &pa);
+	if (!kva) {
+		return -2;
+	}
+	va = sm_va_alloc(pages);
+	if (!va) {
+		sm_bo_free_mem(kva, size);
+		return -3;
+	}
+	if (sm_va_map_4k(va, pa, size)) {
+		sm_va_free(va, pages);
+		sm_bo_free_mem(kva, size);
+		return -4;
+	}
+	sm.bo[slot].kva = kva;
+	sm.bo[slot].pa = pa;
+	sm.bo[slot].size = size;
+	sm.bo[slot].gpu_va = va;
+	sm.bo[slot].used = TRUE;
+	return 0;
+}
+
+/*
+ * Close a BO: unmap the VA first -- the PTE is cleared and the walk flushed,
+ * so nothing can still reach the memory -- and only then hand the physical
+ * allocation back.
+ */
+static void
+sm_bo_close(uint32_t slot)
+{
+	struct sm_bo *bo;
+
+	if (slot >= SM_BO_MAX) {
+		return;
+	}
+	bo = &sm.bo[slot];
+	if (!bo->used) {
+		return;
+	}
+	if (bo->gpu_va) {
+		sm_va_unmap(bo->gpu_va, bo->size);
+		sm_va_free(bo->gpu_va,
+		    (uint32_t)(bo->size / SM_GPU_PAGE_SIZE));
+		/*
+		 * The VA is *kept* in the handle: a case may name it after
+		 * the free to show that the address is now refused, and the
+		 * next open of this slot overwrites it.
+		 */
+	}
+	sm_bo_free_mem(bo->kva, bo->size);
+	bo->kva = 0;
+	bo->pa = 0;
+	bo->used = FALSE;
+}
+
+/* The BO's first page becomes a byte-exact copy of the descriptor page, so a
+ * batch whose pointers name the BO sees exactly what the page holds. */
+static void
+sm_bo_fill(uint32_t slot)
+{
+	const uint8_t *src = (const uint8_t *)sm.tri;
+	uint8_t *dst;
+
+	if (slot >= SM_BO_MAX || !sm.bo[slot].used) {
+		return;
+	}
+	dst = (uint8_t *)sm.bo[slot].kva;
+	for (uint32_t i = 0; i < SM_GPU_PAGE_SIZE; i++) {
+		dst[i] = src[i];
+	}
+	sm_cache_clean_invalidate(sm.bo[slot].kva, SM_GPU_PAGE_SIZE);
+}
+
+/* The VA a case names for the batch's page-internal pointers. */
+static uint64_t
+sm_case_va_base(uint32_t va_flags)
+{
+	if (va_flags & SM_VA_BO0) {
+		return sm.bo[0].gpu_va;
+	}
+	if (va_flags & SM_VA_BO1) {
+		return sm.bo[1].gpu_va;
+	}
+	if (va_flags & SM_VA_BO2) {
+		return sm.bo[2].gpu_va;
+	}
+	if (va_flags & SM_VA_GUARD) {
+		return SM_VA_AREA_BASE + SM_VA_GUARD_OFF;
+	}
+	return 0;
+}
+
+/*
+ * The A3/B1 lifecycle, driven from the case table rather than from code in
+ * the loop: each entry names one step, and every step logs the state it
+ * produced, so a failure belongs to a step and never to the batch.
+ */
+static int
+sm_case_action(uint32_t action, const char *name)
+{
+	int rc = 0;
+
+	switch (action) {
+	case SM_ACT_NONE:
+		return 0;
+	case SM_ACT_BO0:
+		rc = sm_bo_open(0, SM_GPU_PAGE_SIZE);
+		break;
+	case SM_ACT_BO1:
+		/*
+		 * Deliberately 2 MiB: it runs past the end of the first PMD
+		 * entry, so mapping it has to create a *second* PTE page.
+		 */
+		rc = sm_bo_open(1, 512ull * SM_GPU_PAGE_SIZE);
+		break;
+	case SM_ACT_BO0_FREE:
+		sm_bo_close(0);
+		break;
+	case SM_ACT_BO2:
+		rc = sm_bo_open(2, SM_GPU_PAGE_SIZE);
+		break;
+	case SM_ACT_BO_FIN:
+		sm_bo_close(1);
+		sm_bo_close(2);
+		break;
+	default:
+		rc = -1;
+		break;
+	}
+	printf("SWEETMALI: IDXB %s act=%u rc=%d bo0=%llx/%llx bo1=%llx/%llx "
+	    "bo2=%llx/%llx pool=%u/%u\n", name, action, rc,
+	    (unsigned long long)sm.bo[0].gpu_va,
+	    (unsigned long long)sm.bo[0].pa,
+	    (unsigned long long)sm.bo[1].gpu_va,
+	    (unsigned long long)sm.bo[1].pa,
+	    (unsigned long long)sm.bo[2].gpu_va,
+	    (unsigned long long)sm.bo[2].pa,
+	    sm.pool_used, SM_TABLE_POOL_PAGES);
+	return rc;
+}
+
+/*
+ * Build one complete page-table set: the identity maps for everything the
+ * probe touches, the VA window over the same memory, and the 4 KiB window
+ * over "page4k_pa".  AS0 gets the shader code page there, AS1 a page of
+ * zeros, so the two address spaces differ in exactly one PTE and nothing
+ * else -- which is what makes "this job really ran in AS1" observable.
+ */
+static void
+sm_pt_build(uint64_t page4k_pa)
+{
+	sm_map_2m(sm.tables_pa);
+	sm_map_2m(sm.as1_tables_pa);
+	sm_map_2m(sm.job_pa);
+	sm_map_2m(sm.target_pa);
+	sm_map_2m(sm.tri_pa);
+	sm_map_range(sm.heap_pa, sm.heap_pa + sm.heap_size);
+	sm_map_range(SM_PANEL_FB_PA, SM_PANEL_FB_PA + SM_PANEL_BYTES);
+
+	/*
+	 * The same memory a second time at a VA window that is *not* its
+	 * physical address.  A batch whose pointers use these addresses only
+	 * works if the hardware walks the page tables, which is what the BO
+	 * (and eventually multi-AS) support needs.
+	 */
+	sm_map_2m_at(SM_VAW_TRI, sm.tri_pa);
+	sm_map_range_at(SM_VAW_HEAP, sm.heap_pa, sm.heap_size);
+	sm_map_range_at(SM_VAW_FB, SM_PANEL_FB_PA, SM_PANEL_BYTES);
+	/*
+	 * And one page alone through the 4 KiB walk (PTE table page 4).  Its
+	 * neighbours stay unmapped, so a fetch that crosses the 4 KiB
+	 * boundary must fault instead of finding more of the block.
+	 */
+	sm_map_4k_at(SM_VAW4K + (page4k_pa & 0xfffull), page4k_pa);
+	__asm__ volatile("dsb sy" ::: "memory");
+	sm_cache_clean_invalidate(sm_pt_tables,
+	    SM_TABLES_PAGES * SM_GPU_PAGE_SIZE);
+}
+
+static void
+sm_pt_zero(void)
+{
+	uint64_t *tables = sm_pt_tables;
+
+	for (uint32_t i = 0; i < 512u * SM_TABLES_PAGES; i++) {
+		tables[i] = 0;
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+static int
+sm_mmu_init(void)
+{
+	int rc;
+
+	rc = sm_mmu_alloc();
+	if (rc) {
+		return rc;
+	}
+
+	/* AS0: identity + window, and the code page in the 4 KiB window. */
+	sm_pt_select(0);
+	sm_pt_zero();
+	sm_pt_build(sm.tri_pa);
+
+	/* AS1: the same set, except a page of zeros in the 4 KiB window. */
+	sm_pt_select(1);
+	sm_pt_zero();
+	sm_pt_build(sm.zero_pa);
+
+	/*
+	 * A3: the allocator starts empty -- no VA handed out, no area PMD
+	 * page, no pool page used.  The softc is zeroed, but say it here so
+	 * the boot log states the initial condition the cases then change.
+	 */
+	sm.pool_used = 0;
+	sm.area_pmd = NULL;
+	sm_pt_select(0);
+	printf("SWEETMALI: A3 area=%llx size=%llx pages=%u pool=%u\n",
+	    (unsigned long long)SM_VA_AREA_BASE,
+	    (unsigned long long)SM_VA_AREA_SIZE, SM_VA_AREA_PAGES,
+	    SM_TABLE_POOL_PAGES);
+
+	/*
+	 * Boot-time proof that the identity maps (PMD table page 2) and the
+	 * custom window (page 3) are separate: an identity entry must still
+	 * point at its own block and the window entries at the blocks asked
+	 * for.  A collision would show up here as a wrong/missing pointer.
+	 */
+	{
+		const uint64_t *tb = (const uint64_t *)sm.tables;
+		const uint64_t *t1 = (const uint64_t *)sm.as1_tables;
+		uint32_t tri_pmd = (uint32_t)((sm.tri_pa >> 21) & 0x1ffull);
+		uint32_t heap_pmd = (uint32_t)((sm.heap_pa >> 21) & 0x1ffull);
+		uint32_t tri_pud = (uint32_t)((sm.tri_pa >> 30) & 0x1ffull);
+		uint64_t va4k = SM_VAW4K + (sm.tri_pa & 0xfffull);
+		uint32_t pte = (uint32_t)((va4k >> 12) & 0x1ffull);
+
+		printf("SWEETMALI: TBL idpud%u=%llx idpmd%u=%llx idpmd%u=%llx "
+		    "winpud%u=%llx win0=%llx win32=%llx win256=%llx\n",
+		    tri_pud, (unsigned long long)tb[512 + tri_pud],
+		    tri_pmd, (unsigned long long)tb[1024 + tri_pmd],
+		    heap_pmd, (unsigned long long)tb[1024 + heap_pmd],
+		    SM_VA_PUD_INDEX,
+		    (unsigned long long)tb[512 + SM_VA_PUD_INDEX],
+		    (unsigned long long)tb[SM_VA_PMD_PAGE * 512u],
+		    (unsigned long long)tb[SM_VA_PMD_PAGE * 512u + 32u],
+		    (unsigned long long)tb[SM_VA_PMD_PAGE * 512u + 256u]);
+		printf("SWEETMALI: TBL4K va=%llx pmd%u=%llx pte%u=%llx\n",
+		    (unsigned long long)va4k, SM_VA_PMD4K_INDEX,
+		    (unsigned long long)tb[SM_VA_PMD_PAGE * 512u +
+		    SM_VA_PMD4K_INDEX], pte,
+		    (unsigned long long)tb[SM_VA_PTE_PAGE * 512u + pte]);
+		/*
+		 * The same slot of the second address space, one PTE apart
+		 * from AS0: an identity entry must be byte-identical, the
+		 * 4 KiB entry must point somewhere else.
+		 */
+		printf("SWEETMALI: TBL4K1 va=%llx pmd%u=%llx pte%u=%llx "
+		    "idpmd%u=%llx\n", (unsigned long long)va4k,
+		    SM_VA_PMD4K_INDEX,
+		    (unsigned long long)t1[SM_VA_PMD_PAGE * 512u +
+		    SM_VA_PMD4K_INDEX], pte,
+		    (unsigned long long)t1[SM_VA_PTE_PAGE * 512u + pte],
+		    tri_pmd, (unsigned long long)t1[1024 + tri_pmd]);
+	}
+
+	rc = sm_mmu_configure_as(0, sm.tables_pa);
+	if (rc) {
+		printf("SWEETMALI: MMU AS0 setup failed rc=%d\n", -rc);
+		return rc;
+	}
+	rc = sm_mmu_configure_as(1, sm.as1_tables_pa);
+	if (rc) {
+		printf("SWEETMALI: MMU AS1 setup failed rc=%d\n", -rc);
+		return rc;
+	}
+	printf("SWEETMALI: MMU AS0 ready (identity 2 MiB blocks; VA window "
+	    "%llx: tri=%llx heap=%llx fb=%llx) AS1 page=%llx\n",
+	    (unsigned long long)SM_VA_BASE,
+	    (unsigned long long)(SM_VAW_TRI +
+	    (sm.tri_pa & (SM_MALI_BLOCK_2M - 1ull))),
+	    (unsigned long long)(SM_VAW_HEAP +
+	    (sm.heap_pa & (SM_MALI_BLOCK_2M - 1ull))),
+	    (unsigned long long)(SM_VAW_FB +
+	    (SM_PANEL_FB_PA & (SM_MALI_BLOCK_2M - 1ull))),
+	    (unsigned long long)sm.zero_pa);
+	return 0;
+}
+
+/*
+ * One write-value job through JS0 with START_MMU set.  The GPU fetches the
+ * descriptor and writes the immediate through AS0, so this proves both the
+ * job scheduler and the MMU.  The target starts at a sentinel that differs
+ * from the value the GPU writes.
+ */
+static int
+sm_write_value_test(void)
+{
+	volatile uint32_t *hdr = (volatile uint32_t *)sm.job;
+	uint64_t value = 0xa5a5a5a55a5a5a5aull;
+	uint64_t before = 0x1111222233334444ull;
+	uint64_t got;
+	uint32_t js = 0;
+	uint32_t status = 0;
+	uint32_t i;
+
+	for (i = 0; i < SM_GPU_PAGE_SIZE / 4u; i++) {
+		hdr[i] = 0;
+	}
+	hdr[4] = ((SM_JOB_TYPE_WRITE_VALUE & 0x7fu) << 1) | (1u << 16);
+	hdr[8] = (uint32_t)sm.target_pa;
+	hdr[9] = (uint32_t)(sm.target_pa >> 32);
+	hdr[10] = SM_WRITE_VALUE_IMM64 & 0x7u;
+	hdr[11] = 0;
+	hdr[12] = (uint32_t)value;
+	hdr[13] = (uint32_t)(value >> 32);
+	hdr[14] = 0;
+	hdr[15] = 0;
+
+	*(volatile uint64_t *)sm.target = before;
+	sm_cache_clean_invalidate(sm.job, SM_GPU_PAGE_SIZE);
+	sm_cache_clean_invalidate(sm.target, SM_GPU_PAGE_SIZE);
+
+	sm_wr(sm.gpu + SM_JOB_INT_MASK, 0);
+	sm_wr(sm.gpu + SM_JOB_INT_CLEAR, 0xffffffffu);
+	sm_wr(sm.gpu + SM_MMU_INT_CLEAR, 0xffffffffu);
+
+	sm_wr(sm.gpu + SM_JS_HEAD_NEXT_LO(js), (uint32_t)sm.job_pa);
+	sm_wr(sm.gpu + SM_JS_HEAD_NEXT_HI(js), (uint32_t)(sm.job_pa >> 32));
+	sm_wr(sm.gpu + SM_JS_AFFINITY_NEXT_LO(js), sm.shader_present);
+	sm_wr(sm.gpu + SM_JS_AFFINITY_NEXT_HI(js), 0);
+	sm_wr(sm.gpu + SM_JS_CONFIG_NEXT(js),
+	    SM_JS_CONFIG_BASE | SM_JS_CONFIG_START_MMU);
+	sm_wr(sm.gpu + SM_JS_COMMAND_NEXT(js), SM_JS_COMMAND_START);
+
+	for (i = 0; i < SM_TIMEOUT_STEPS; i++) {
+		status = sm_rd(sm.gpu + SM_JOB_INT_RAWSTAT);
+		if (status & ((1u << js) | (1u << (16u + js)))) {
+			break;
+		}
+		delay(SM_TIMEOUT_US);
+	}
+
+	printf("SWEETMALI: WV rawstat=%x js_status=%x mmu=%x\n", status,
+	    sm_rd(sm.gpu + SM_JS_STATUS(js)),
+	    sm_rd(sm.gpu + SM_MMU_INT_RAWSTAT));
+	if (status & (1u << (16u + js))) {
+		printf("SWEETMALI: WV FAULT status=%x addr=%x%x\n",
+		    sm_rd(sm.gpu + SM_AS_FAULTSTATUS(0)),
+		    sm_rd(sm.gpu + SM_AS_FAULTADDRESS_HI(0)),
+		    sm_rd(sm.gpu + SM_AS_FAULTADDRESS_LO(0)));
+	}
+	sm_wr(sm.gpu + SM_JOB_INT_CLEAR, status);
+	sm_wr(sm.gpu + SM_MMU_INT_CLEAR, 0xffffffffu);
+
+	sm_cache_clean_invalidate(sm.target, SM_GPU_PAGE_SIZE);
+	got = *(volatile uint64_t *)sm.target;
+
+	printf("SWEETMALI: WV value=%llx expected=%llx %s\n", got, value,
+	    (got == value) ? "PASS" : "FAIL");
+	return (got == value) ? 0 : -1;
+}
