+	vjob[61] = (uint32_t)(tls_a >> 32);
+	vjob[78] = (uint32_t)tls_a;
+	vjob[79] = (uint32_t)(tls_a >> 32);
+	vjob[62] = (uint32_t)tls_a;
+	vjob[63] = (uint32_t)(tls_a >> 32);
+
+	/* Cache flush job (shader core LS + L2). */
+	cflush[4] = (3u << 1) | (1u << 16);
+	cflush[8] = 0x03030007u;
+	cflush[9] = 3u;
+
+	/* Refresh the tiler heap window the hardware may walk from base. */
+	zero = sm.heap_size < SM_TILER_HEAP_ZERO ?
+	    sm.heap_size : SM_TILER_HEAP_ZERO;
+
+	/*
+	 * The fully built page is the only state from which a job is known to
+	 * be accepted, so keep a byte-exact copy of it and restore that copy
+	 * before every submission.
+	 */
+	sm_snap_take();
+	sm_snap_diff("built");
+
+	for (ci = 0; ci < sizeof(cases) / sizeof(cases[0]); ci++) {
+		uint8_t *idxs;
+		uint64_t idx_a;
+		uint32_t exv;
+		uint32_t pre;
+		uint32_t cfst;
+		uint32_t asf;
+		int mmu_want;
+		int rc;
+
+		if (cases[ci].reset) {
+			rc = sm_case_reset();
+			printf("SWEETMALI: IDX %s RESET rc=%d js0=%x js1=%x\n",
+			    cases[ci].name, rc,
+			    sm_rd(sm.gpu + SM_JS_STATUS(0)),
+			    sm_rd(sm.gpu + SM_JS_STATUS(1)));
+			if (rc) {
+				printf("SWEETMALI: IDX %s SKIP reset failed\n",
+				    cases[ci].name);
+				continue;
+			}
+		}
+
+		/*
+		 * The hardware writes state back into the descriptor page:
+		 * words 34..36 of the vertex job, the block at 0x2c0, the tiler
+		 * heap pointers (0x210/0x218) and the polygon list (0x240).
+		 * A header re-submitted with that leftover is rejected with
+		 * DATA_INVALID at its own address (0x58, or 0x10258 when word 0
+		 * is dirty too).  Restoring the built page byte for byte is what
+		 * makes repeated batches possible at all.
+		 */
+		pre = *(volatile uint32_t *)vjob;
+		sm_snap_restore();
+		/*
+		 * Which address space this batch runs in.  kbase's
+		 * kbase_job_hw_submit() puts the AS number in the low four
+		 * bits of JS_CONFIG, so "run in AS1" is one number handed to
+		 * every submission of the case -- the job chain, the
+		 * descriptors and every pointer stay exactly the same, which
+		 * is the point of the test.
+		 */
+		asf = (cases[ci].va & SM_VA_AS1) ? 1u : 0u;
+
+		/*
+		 * A3/B1: the case's lifecycle step runs before the batch, and
+		 * its log line is the state the batch will see.
+		 */
+		if (cases[ci].action && sm_case_action(cases[ci].action,
