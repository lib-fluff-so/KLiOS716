+		uint32_t *res = (uint32_t *)(base + SM_TRI_RES);
+		uint32_t *va = (uint32_t *)(base + SM_TRI_ATTR);
+		const uint64_t attr_a = base_pa + SM_TRI_ATTR;
+		const uint64_t abuf_a = base_pa + SM_TRI_ATTRBUF;
+		uint32_t bi;
