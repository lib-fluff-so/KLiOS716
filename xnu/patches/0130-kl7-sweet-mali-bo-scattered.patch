 /*
+ * F3: the same mapping for a buffer that is only *virtually* contiguous.
+ *
+ * A BO whose contiguous allocation failed comes from kmem_alloc() instead,
+ * which hands back a wired kernel VA whose pages are wherever the VM put
+ * them.  The GPU has no way to see that: every page is mapped separately, at
+ * the same 4 KiB granularity sm_va_map_4k() uses, so the hardware still walks
+ * one contiguous VA range and the rest of the driver (SUBMIT, cache
+ * maintenance, the descriptor page) never learns the difference.  The cost is
+ * one ml_vtophys() per page, which is a page-table walk apiece -- 32768 of
+ * them for panfrost's 128 MiB tiler heap.
+ */
+static int
+sm_va_map_4k_scattered(uint64_t va, uint64_t kva, uint64_t size)
+{
+	uint64_t aligned = va & ~(SM_GPU_PAGE_SIZE - 1ull);
+	uint64_t pages = (size + SM_GPU_PAGE_SIZE - 1ull) / SM_GPU_PAGE_SIZE;
+
+	if (!aligned || ((aligned >> 39) & 0x1ffull) ||
+	    ((aligned >> 30) & 0x1ffull) != SM_VA_AREA_PUD_INDEX ||
+	    ((aligned + size - 1ull) >> 30 & 0x1ffull) !=
+	    SM_VA_AREA_PUD_INDEX) {
+		return -1;
+	}
+	sm_pt_select(0);
+	sm_pt_tables[0] = sm_page_table_desc(sm_pt_base + SM_GPU_PAGE_SIZE);
+	for (uint64_t i = 0; i < pages; i++) {
+		uint64_t v = aligned + i * SM_GPU_PAGE_SIZE;
+		uint32_t pmd_index = (uint32_t)((v >> 21) & 0x1ffull);
+		uint32_t pte_index = (uint32_t)((v >> 12) & 0x1ffull);
+		uint64_t pa = (uint64_t)ml_vtophys(kva + i * SM_GPU_PAGE_SIZE);
+		uint64_t *pte;
+
+		if (pa == 0) {
+			return -3;
+		}
+		pte = sm_area_pte_page(pmd_index);
+		if (!pte) {
+			return -2;
+		}
+		pte[pte_index] = sm_page_desc(pa);
+	}
+	sm_cache_clean_invalidate(sm.tables,
+	    SM_TABLES_TOTAL_PAGES * SM_GPU_PAGE_SIZE);
+	return sm_as_flush_pt(0, aligned, pages * SM_GPU_PAGE_SIZE);
+}
