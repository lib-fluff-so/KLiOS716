+/*
+ * The cache sweeps a submission does over its listed BOs.  F1 swept every one of
+ * them in full, twice a job, and panfrost lists eight a job -- the frames among
+ * them, so tens of megabytes -- which put more time into cache maintenance than
+ * into the GPU.  Boot-arg smcache is a size threshold in KB: a BO no larger than
+ * it is still swept (descriptors, uniforms and vertex data are, whatever else
+ * happens), a larger one is left to the client and to SM_SEL_SYNC_BO, which is
+ * where panfrost asks for cache work.  Absent, every BO is swept, as F1 did.
+ * The timings are logged either way, so what the sweeps cost stays visible.
+ */
+static int64_t sm_sweep_kb = -1;
+static int sm_sweep_asked;
 
