 /* ---- D2: client memory and submission ---------------------------- */
+
+/*
+ * The refusals of CREATE_BO (-2: no free handle, -3: no GPU address in the
+ * area, -4: no page table for it) all reach userspace as one error, and the
+ * renderer dies of whichever it was without saying which.  The first one is
+ * spelled out here, so the ring names the table that ran out.
+ */
+static void
+sm_uc_bo_refused(uint64_t size, int rc)
+{
+	static boolean_t said = FALSE;
+
+	if (!said) {
+		said = TRUE;
+		IOLog("SWEETMALI: CREATE_BO refused size %llu rc %d%s\n", size, rc,
+		    rc == -2 ? " (SM_BO_MAX handles are in use)" :
+		    rc == -3 ? " (the GPU address area is full)" :
+		    " (no page table for the area)");
+	}
+}
 
