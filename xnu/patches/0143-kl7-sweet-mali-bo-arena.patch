 /*
+ * F3: the contiguous BO arena.
+ *
+ * Panfrost mmaps every BO it makes, and a BO can only be mapped into a client
+ * when its pages are physically adjacent.  Once iOS has been up for a minute
+ * the free page list is broken into pieces smaller than a single large BO:
+ * the crash ring shows vm_page_find_contiguous(737 pages = 2.9 MB) finding
+ * zero runs while ~1 GB of pages sat free, and a 12 MB BO then fell back to
+ * kmem_alloc(), which sm_bo_info() has to refuse, which makes Mesa close
+ * backboardd on the mmap EINVAL.
+ *
+ * The arena is one physically contiguous allocation taken while the machine
+ * is still empty.  BOs are carved out of it and returned to it, so a BO is
+ * always contiguous no matter what the rest of DRAM looks like.  smarena=<MB>
+ * sizes it (default 384, 0 disables); if it is exhausted the old
+ * IOMallocContiguous path is still tried.
+ */
+#define SM_BO_ARENA_MB_DEFAULT  640u
+#define SM_BO_ARENA_MB_MIN      64u
+
+struct sm_bo_arena {
+	vm_offset_t kva;
+	uint64_t pa;
+	uint64_t size;
+	uint32_t pages;
+	uint32_t words;
+	uint32_t *used;
+	uint32_t used_pages;
+};
+
+/* F4: total RAM the VM initialised (<mach/vm_param.h>). */
+extern uint64_t sane_size;
+
+static struct sm_bo_arena sm_arena;
+
+static boolean_t
+sm_arena_bit(uint32_t page)
+{
+	return (sm_arena.used[page >> 5] & (1u << (page & 31u))) != 0;
+}
+
+static boolean_t
+sm_arena_init(uint64_t bytes)
+{
+	uint32_t words;
+	void *kva;
+	void *bits;
+
+	bytes &= ~(uint64_t)(SM_GPU_PAGE_SIZE - 1u);
+	if (bytes < ((uint64_t)SM_BO_ARENA_MB_MIN << 20)) {
+		return FALSE;
+	}
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wdeprecated-declarations"
+	kva = IOMallocContiguous((vm_size_t)bytes, SM_GPU_PAGE_SIZE, NULL);
+#pragma clang diagnostic pop
+	if (kva == NULL) {
+		return FALSE;
+	}
+	words = (uint32_t)((bytes / SM_GPU_PAGE_SIZE + 31u) / 32u);
+	bits = IOMalloc((vm_size_t)words * sizeof(uint32_t));
+	if (bits == NULL) {
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wdeprecated-declarations"
+		IOFreeContiguous(kva, (vm_size_t)bytes);
+#pragma clang diagnostic pop
+		return FALSE;
+	}
+	memset(bits, 0, (size_t)words * sizeof(uint32_t));
+	sm_arena.kva = (vm_offset_t)kva;
+	sm_arena.pa = (uint64_t)ml_vtophys((vm_offset_t)kva);
+	sm_arena.size = bytes;
+	sm_arena.pages = (uint32_t)(bytes >> 12);
+	sm_arena.words = words;
+	sm_arena.used = (uint32_t *)bits;
+	sm_arena.used_pages = 0;
+	printf("SWEETMALI: BO arena %llu MB at pa %llx kva %lx\n",
+	    bytes >> 20, sm_arena.pa, (unsigned long)sm_arena.kva);
+	return TRUE;
+}
+
+/*
+ * First fit over the arena bitmap.  `alignment` is honoured on the start page;
+ * everything the driver allocates here is page aligned anyway.
+ */
+static vm_offset_t
+sm_arena_alloc(uint64_t size, uint64_t alignment, uint64_t *pa)
+{
+	uint32_t need = (uint32_t)(size >> 12);
+	uint32_t step = (uint32_t)(alignment >> 12);
+	uint32_t page, i;
+
+	if (sm_arena.kva == 0 || need == 0 || need > sm_arena.pages ||
+	    need > sm_arena.pages - sm_arena.used_pages) {
+		return 0;
+	}
+	if (step == 0) {
+		step = 1;
+	}
+	for (page = 0; page + need <= sm_arena.pages; page += step) {
+		for (i = 0; i < need; i++) {
+			if (sm_arena_bit(page + i)) {
+				break;
+			}
+		}
+		if (i < need) {
+			continue;
+		}
+		for (i = 0; i < need; i++) {
+			sm_arena.used[(page + i) >> 5] |=
+			    1u << ((page + i) & 31u);
+		}
+		sm_arena.used_pages += need;
+		*pa = sm_arena.pa + ((uint64_t)page << 12);
+		return sm_arena.kva + ((vm_offset_t)page << 12);
+	}
+	return 0;
+}
+
+/* TRUE when kva came out of the arena and has been given back. */
+static boolean_t
+sm_arena_free(vm_offset_t kva, uint64_t size)
+{
+	uint64_t off;
+	uint32_t first, pages, i;
+
+	if (sm_arena.kva == 0 || kva < sm_arena.kva ||
+	    kva >= sm_arena.kva + (vm_offset_t)sm_arena.size) {
+		return FALSE;
+	}
+	off = (uint64_t)(kva - sm_arena.kva);
+	if ((off & (SM_GPU_PAGE_SIZE - 1u)) != 0 || off + size > sm_arena.size) {
+		return FALSE;
+	}
+	first = (uint32_t)(off >> 12);
+	pages = (uint32_t)(size >> 12);
+	for (i = 0; i < pages; i++) {
+		sm_arena.used[(first + i) >> 5] &=
+		    ~(1u << ((first + i) & 31u));
+	}
+	sm_arena.used_pages -= pages;
+	return TRUE;
+}
