+	out->param[SM_PARAM_AS_PRESENT] = sm.as_present;
+	out->param[SM_PARAM_JS_PRESENT] = sm.js_present;
+	out->param[SM_PARAM_L2_FEATURES] = sm_rd(sm.gpu + SM_GPU_L2_FEATURES);
+	out->param[SM_PARAM_CORE_FEATURES] = sm_rd(sm.gpu + SM_GPU_CORE_FEATURES);
+	out->param[SM_PARAM_TILER_FEATURES] = sm_rd(sm.gpu + SM_GPU_TILER_FEATURES);
+	out->param[SM_PARAM_MEM_FEATURES] = sm.mem_features;
+	out->param[SM_PARAM_MMU_FEATURES] = sm.mmu_features;
+	out->param[SM_PARAM_THREAD_FEATURES] = sm.thread_features;
+	out->param[SM_PARAM_MAX_THREADS] = sm.max_threads;
+	out->param[SM_PARAM_THREAD_MAX_WORKGROUP_SZ] = sm.max_workgroup;
+	out->param[SM_PARAM_THREAD_MAX_BARRIER_SZ] = sm.max_barrier;
+	out->param[SM_PARAM_COHERENCY_FEATURES] = sm.coherency_features;
+	for (n = 0; n < 4u; n++) {
