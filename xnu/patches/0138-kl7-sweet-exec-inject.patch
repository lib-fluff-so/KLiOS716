+/*
+ * Bring-up aid: the sysctl kern.exec_inject holds "LIBRARY NAME NAME ..."; every program
+ * whose file name is one of the NAMEs is started with DYLD_INSERT_LIBRARIES=LIBRARY in its
+ * environment, so that dyld loads our library into it. Several such groups may follow each
+ * other, separated by ";". A program named in more than one group gets every one of those
+ * libraries, joined with ":" in the one DYLD_INSERT_LIBRARIES, so a window server can carry
+ * both its own library and a tweak loader. launchd refuses to pass DYLD_ variables from a
+ * job description, which is why the kernel adds this one. The boot-arg
+ * "sweetinject=LIB:NAME:NAME[;LIB:NAME...]" sets it at boot (":" becomes " ").
+ */
+static char exec_inject_conf[512];
+SYSCTL_STRING(_kern, OID_AUTO, exec_inject, CTLFLAG_RW | CTLFLAG_LOCKED, exec_inject_conf, sizeof(exec_inject_conf),
+    "LIBRARY NAME... [; LIBRARY NAME...]: programs started with the library inserted");
+
+static boolean_t exec_inject_boot_done;
+static int exec_inject_logged;
+
+static void
+exec_inject_bootarg(void)
+{
+	char arg[sizeof(exec_inject_conf)];
+	const char *s = arg;
+	char *d = exec_inject_conf;
+
+	exec_inject_boot_done = TRUE;
+	if (!PE_parse_boot_argn("sweetinject", arg, sizeof(arg))) {
+		return;
+	}
+	/*
+	 * A boot-arg cannot carry spaces: "LIB:NAME:NAME;LIB:NAME" becomes
+	 * "LIB NAME NAME;LIB NAME", the form kern.exec_inject takes.
+	 */
+	while (*s != 0 && d < &exec_inject_conf[sizeof(exec_inject_conf) - 1]) {
+		*d++ = (*s == ':') ? ' ' : *s;
+		s++;
+	}
+	*d = 0;
+	if (exec_inject_conf[0] != 0) {
+		printf("SWEET EXEC: kern.exec_inject is '%s'\n", exec_inject_conf);
+	}
+}
+
+static bool
+exec_inject_env(struct image_params *imgp, char *env, size_t size)
+{
+	const char *name, *p = exec_inject_conf;
+	size_t namelen, used;
+	bool any = false;
+
+	if (!exec_inject_boot_done) {
+		exec_inject_bootarg();
+	}
+	if (*p == 0) {
+		return false;
+	}
+	{
+		/*
+		 * The name that matters is the file name of the program being exec'd.
+		 * ni_cnd.cn_nameptr/cn_namelen do not reliably hold it here (the lookup
+		 * has moved past them), so take it out of the path exec_save_path stored
+		 * behind EXECUTABLE_KEY.
+		 */
+		const char *path = (imgp->ip_strings != NULL) ? imgp->ip_strings + strlen(EXECUTABLE_KEY) : "";
+		const char *slash = strrchr(path, '/');
+
+		name = (slash != NULL) ? slash + 1 : path;
+		namelen = strlen(name);
+	}
+	used = strlcpy(env, "DYLD_INSERT_LIBRARIES=", size);
+	while (*p != 0) {
+		const char *library;
+		size_t liblen;
+		bool matched = false;
+
+		while (*p == ' ' || *p == ';') {
+			p++;
+		}
+		library = p;
+		while (*p != 0 && *p != ' ' && *p != ';') {
+			p++;
+		}
+		liblen = (size_t)(p - library);
+		while (*p == ' ') {
+			const char *word = ++p;
+
+			while (*p != 0 && *p != ' ' && *p != ';') {
+				p++;
+			}
+			if (!matched && (size_t)(p - word) == namelen && namelen != 0 && liblen != 0 &&
+			    strncmp(word, name, namelen) == 0) {
+				matched = true;         /* this group names this program; its library is added once */
+			}
+		}
+		if (matched && liblen != 0 && used + 1 + liblen < size) {
+			if (any) {
+				env[used++] = ':';      /* dyld takes several libraries separated by ":" */
+			}
+			memcpy(env + used, library, liblen);
+			used += liblen;
+			env[used] = 0;
+			any = true;
+		}
+	}
+	if (any) {
+		printf("SWEET EXEC: %s -> INSERTED %s\n", name, env);
+	} else if (exec_inject_logged < 400 && strcmp(name, "xpcproxy") != 0) {
+		exec_inject_logged++;
+		printf("SWEET EXEC: candidate '%s'\n", name);
+	}
+	return any;
+}
