+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/*
+ * F1: the root is HFS+ and the host cannot write it, so the payload carries
+ * a small blob that this hook installs with the kernel's own vnode path just
+ * before launchd starts.  Defined in bsd/dev/sweet_f1_install.c.
+ */
+extern void sweet_f1_install(void);
+#endif
+
