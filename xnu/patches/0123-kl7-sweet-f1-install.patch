@@ -1098,6 +1107,15 @@ bsdinit_task(void)
 
 	bsd_init_kprintf("bsd_do_post - done");
 
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	/*
+	 * F1: the root vnode exists now and launchd has not scanned
+	 * /System/Library/LaunchDaemons yet.  A normal boot has no sweetf1
+	 * boot arg, in which case this returns immediately.
+	 */
+	sweet_f1_install();
+#endif
+
 	load_init_program(p);
 	lock_trace = 1;
