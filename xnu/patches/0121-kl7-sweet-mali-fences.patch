+/*
+ * D3: fences, waits, cache sync, fault reset and recovery.
+ *
+ * The interesting group is the last one.  A job whose write target is a BO
+ * that has been created, read and closed cannot land anywhere: CLOSE_BO
+ * cleared the PTE, so the job takes an MMU fault.  The submit path must
+ * report it, reset the GPU, and the next job must still write -- that is the
+ * recovery path this stage exists for, and it is exercised on purpose rather
+ * than reasoned about.
+ */
+#define SM_D3_VALUE1 0x0123456789abcdefull
+#define SM_D3_VALUE2 0x0fedcba987654321ull
+#define SM_D3_VALUE3 0xa5a5a5a5a5a5a5a5ull
