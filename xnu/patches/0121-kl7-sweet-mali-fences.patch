+static void
+sm_d3_job(volatile uint32_t *desc, uint64_t target, uint64_t value)
+{
+	uint32_t i;
+
+	for (i = 0; i < SM_BO_PAGE_SIZE / 4u; i++) {
+		desc[i] = 0;
+	}
+	desc[4] = ((SM_D2_JOB_WRITE_VALUE & 0x7fu) << 1) | (1u << 16);
+	desc[8] = (uint32_t)target;
+	desc[9] = (uint32_t)(target >> 32);
+	desc[10] = SM_D2_IMM64 & 0x7u;
+	desc[12] = (uint32_t)value;
+	desc[13] = (uint32_t)(value >> 32);
+}
