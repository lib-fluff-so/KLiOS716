+/*
+ * Take this client's mapping of a BO away, if IOKit made one, and drop the
+ * descriptor it was handed for it.  Called from CLOSE_BO and from
+ * clientClose(), always before the core frees the BO's pages: a page that is
+ * still a User CPU mapping cannot be freed (pmap_assert_free: ... is a User
+ * CPU mapping).
+ *
+ * removeMappingForDescriptor() returns the IOMemoryMap IOUserClient created
+ * from that descriptor, and stops tracking it -- the only handle a driver has
+ * on a client's mapping.  unmap() then destroys the mapping itself; releasing
+ * the map alone is not enough, because the descriptor's own mapping list and
+ * the client's Mach port also hold references to it.
+ */
+void
+SweetMaliUserClient::unmapAndForgetBo(uint32_t handle)
+{
+	IOMemoryDescriptor *md;
+	IOMemoryMap *map;
+
+	if (handle >= SM_BO_MAX) {
+		return;
+	}
+	md = fBoMem[handle];
+	if (md == NULL) {
+		return;
+	}
+	fBoMem[handle] = NULL;
+
+	map = removeMappingForDescriptor(md);
+	if (map != NULL) {
+		map->unmap();
+		map->release();
+	}
+	/* Our cache's reference; the map's own reference, if any, lives on. */
+	md->release();
+}
