+/*
+ * IOSurfaceClientWrapClientImage (selector 6): CoreAnimation has an image of
+ * its own -- the pictures it makes surfaces around -- and wants a surface over
+ * that very memory: the caller's, already there, not a copy.
+ *
+ * The input is 32 bytes -- the address of the pixels, the width, the height,
+ * the pixel format, the bytes an element, the bytes a row and the size the
+ * caller has -- and the answer is the same lock result a create answers with.
+ * The memory is mapped into the caller (which already has it) and wired for the
+ * GPU while a surface names it.
+ *
+ * Until this was implemented the selector fell through to the default answer,
+ * success with zeros, so the framework built a surface with id 0 and no
+ * geometry: the pictures and every run of text came out as a black or coloured
+ * rectangle, the colour of the glyph, because a texture that is never filled
+ * samples as nothing.
+ */
 IOReturn
+IOSurfaceRootUserClient::wrapClientImage(IOExternalMethodArguments *args)
+{
+	uint8_t in[0x20];
+	uint64_t address, length;
+	uint32_t width, height, format, bytesPerElement, bytesPerRow, size;
+	uint32_t swapped = 0, id = 0, logged;
+	SweetSurface *s;
+	IOReturn ret;
+
+	if (args->structureInput != NULL && args->structureInputSize >= sizeof(in)) {
+		memcpy(in, args->structureInput, sizeof(in));
+	} else if (args->structureInputDescriptor != NULL &&
+	    args->structureInputDescriptor->getLength() >= sizeof(in)) {
+		args->structureInputDescriptor->readBytes(0, in, sizeof(in));
+	} else {
+		IOLog("SWEET SURF: wrapClientImage: no input (%u bytes)\n",
+		    (uint32_t)args->structureInputSize);
+		return kIOReturnBadArgument;
+	}
+	memcpy(&address, in + 0x00, sizeof(address));
+	memcpy(&width, in + 0x08, 4);
+	memcpy(&height, in + 0x0c, 4);
+	memcpy(&format, in + 0x10, 4);
+	memcpy(&bytesPerElement, in + 0x14, 4);
+	memcpy(&bytesPerRow, in + 0x18, 4);
+	memcpy(&size, in + 0x1c, 4);
+
+	logged = sweet_surface_wraps_logged++;
+	if (logged < 64 || (logged % 512) == 0) {
+		char name[32];
+		proc_selfname(name, sizeof(name));
+		IOLog("SWEET SURF: %s wrapClientImage #%u addr 0x%llx %ux%u fmt 0x%x bpe %u bpr %u size %u\n",
+		    name, logged + 1, (unsigned long long)address, width, height,
+		    format, bytesPerElement, bytesPerRow, size);
+	}
+
+	if (address == 0 || address >= (1ULL << 36) ||
+	    width == 0 || height == 0 ||
+	    width > SWEET_SURFACE_MAX_DIM || height > SWEET_SURFACE_MAX_DIM ||
+	    bytesPerElement == 0 || bytesPerElement > 64) {
+		return kIOReturnBadArgument;
+	}
+	if (bytesPerRow == 0) {
+		bytesPerRow = width * bytesPerElement;
+	} else if ((uint64_t)width * bytesPerElement > bytesPerRow &&
+	    (uint64_t)height * bytesPerElement <= bytesPerRow) {
+		/* The two dimensions may be the other way round: whichever one
+		 * fits inside a row is the width. */
+		uint32_t swap = width;
+		width = height;
+		height = swap;
+		swapped = 1;
+	}
+	if ((uint64_t)width * bytesPerElement > bytesPerRow ||
+	    (uint64_t)bytesPerRow * height > SWEET_SURFACE_MAX_ALLOC) {
+		return kIOReturnBadArgument;
+	}
+	/*
+	 * How far the image really goes: (height - 1) whole rows and the last
+	 * one only `width` elements wide.  `size` is exactly that count (every
+	 * image seen states it), and the caller's mapping ends there: the
+	 * address is an aligned offset into a page-rounded mmap, so a round-up
+	 * to a page reaches the page past the buffer, which belongs to somebody
+	 * else.  Mapping that page fails and the whole image is dropped -- which
+	 * is what the first 53 refusals were, and why whole runs of text and
+	 * rows of icons drew nothing.  `size` is believed only when it fits the
+	 * geometry it came with.
+	 */
+	if (size < (uint64_t)bytesPerRow * (height - 1) + (uint64_t)width * bytesPerElement ||
+	    size > (uint64_t)bytesPerRow * height) {
+		size = (uint32_t)((uint64_t)bytesPerRow * height);
+	}
+	length = size;
+	if (length == 0) {
+		return kIOReturnBadArgument;
+	}
+
+	/*
+	 * The memory has to be the caller's. A wrong reading of the fields lands
+	 * here, not in a fault: copyin() of both ends is the kernel's cheapest
+	 * way of asking "is this mapped in the task I am running for?".
+	 */
+	if (copyin((user_addr_t)address, in, 1) != 0 ||
+	    copyin((user_addr_t)(address + length - 1), in, 1) != 0) {
+		IOLog("SWEET SURF: wrapClientImage: 0x%llx (%u bytes) is not the caller's\n",
+		    (unsigned long long)address, (uint32_t)length);
+		return kIOReturnBadArgument;
+	}
+
+	s = sweet_surface_alloc();
+	if (s == NULL) {
+		return kIOReturnNoMemory;
+	}
+	s->width = width;
+	s->height = height;
+	s->bytesPerRow = bytesPerRow;
+	s->bytesPerElement = (uint16_t)bytesPerElement;
+	s->elementWidth = 1;
+	s->elementHeight = 1;
+	s->pixelFormat = format;
+	s->offset = 0;
+	s->planeCount = 0;
+	s->parentID = 0;
+	s->cacheMode = 0;
+	s->allocSize = (uint32_t)length;
+	s->memory = IOMemoryDescriptor::withAddressRange(address, length,
+	    kIODirectionInOut, fTask);
+	s->mapCache = kIOMapDefaultCache;
+	if (s->memory == NULL || !sweet_surface_publish(s)) {
+		s->release();
+		return kIOReturnNoMemory;
+	}
+	id = s->id;
+	ret = returnSurface(s, args);   /* maps it for the caller, answers the lock result */
+	s->release();
+	if (ret == kIOReturnSuccess && logged < 64) {
+		char name[32];
+		proc_selfname(name, sizeof(name));
+		IOLog("SWEET SURF: %s wrapClientImage -> id %u %ux%u bpr %u len %u%s\n",
+		    name, id, width, height, bytesPerRow, (uint32_t)length,
+		    swapped ? " (width and height swapped)" : "");
+	}
+	return ret;
+}
